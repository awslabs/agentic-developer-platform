{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeOnlyGatewayCluster",
      "Effect": "Allow",
      "Action": "eks:DescribeCluster",
      "Resource": "arn:aws:eks:us-east-1:879318057152:cluster/adp-dev-eks-cluster"
    },
    {
      "Sid": "VerifyImmutableGatewaySourceTags",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:DescribeImages"
      ],
      "Resource": "arn:aws:ecr:us-east-1:879318057152:repository/adp-gateway"
    }
  ]
}
