{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/adp/design/finops/f1",
  "title": "FinOps F1 proposed payload variants; not deployed API registration",
  "$defs": {
    "RecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "source_connection_id",
        "record_type",
        "record_id",
        "record_revision"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "source_connection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "record_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "record_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "not": {
            "enum": [
              "HEAD",
              "latest",
              "null"
            ]
          }
        }
      }
    },
    "CostQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "metric",
        "granularity",
        "group_by",
        "currency"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "metric": {
          "const": "UnblendedCost"
        },
        "granularity": {
          "enum": [
            "DAILY",
            "MONTHLY"
          ]
        },
        "group_by": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SERVICE",
              "LINKED_ACCOUNT"
            ]
          }
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "FinopsRunInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "capability",
        "configuration_revision",
        "binding_id",
        "question",
        "query"
      ],
      "properties": {
        "service_id": {
          "const": "finops"
        },
        "capability": {
          "const": "cost_inquiry"
        },
        "configuration_revision": {
          "type": "integer",
          "minimum": 1
        },
        "binding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "query": {
          "$ref": "#/$defs/CostQuery"
        },
        "sources": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/RecordRef"
          }
        },
        "parent_task_ref": {
          "$ref": "#/$defs/RecordRef"
        }
      }
    },
    "Measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency",
        "estimated",
        "source_refreshed_at",
        "freshness_reason",
        "coverage"
      ],
      "properties": {
        "amount": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "estimated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_refreshed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "freshness_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        }
      }
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "FinopsCostResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "query",
        "scope_digest",
        "binding_generation",
        "attribution",
        "attribution_evidence",
        "native",
        "oracle",
        "comparison",
        "billing_scope"
      ],
      "properties": {
        "kind": {
          "const": "finops_cost_inquiry"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "query": {
          "$ref": "#/$defs/CostQuery"
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "binding_generation": {
          "type": "integer",
          "minimum": 1
        },
        "attribution": {
          "enum": [
            "account",
            "product_verified",
            "partial",
            "unknown"
          ]
        },
        "attribution_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          }
        },
        "native": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "conversation_id",
            "turn_id",
            "answer_artifact",
            "observed_at",
            "measure"
          ],
          "properties": {
            "status": {
              "enum": [
                "answered",
                "refused",
                "failed",
                "outcome_unknown",
                "unavailable"
              ]
            },
            "conversation_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "turn_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "turn_locator": {
              "type": "string",
              "minLength": 1
            },
            "answer_artifact": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "measure": {
              "$ref": "#/$defs/Measure"
            }
          }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "collection_id",
            "query_hash",
            "observed_at",
            "pages",
            "measure"
          ],
          "properties": {
            "collection_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "query_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "observed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "pages": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Artifact"
              }
            },
            "measure": {
              "$ref": "#/$defs/Measure"
            }
          }
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "delta",
            "display_quantum",
            "reason"
          ],
          "properties": {
            "state": {
              "enum": [
                "exact",
                "rounded",
                "mismatch",
                "incomparable",
                "unavailable"
              ]
            },
            "delta": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "display_quantum": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "billing_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account_ids",
            "view_ref",
            "snapshot_artifact"
          ],
          "properties": {
            "account_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9]{12}$"
              }
            },
            "view_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "snapshot_artifact": {
              "$ref": "#/$defs/Artifact"
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/FinopsRunInput"
    },
    {
      "$ref": "#/$defs/FinopsCostResult"
    }
  ]
}
