{
  "contract_version": "1.0",
  "design_revision": "b5761a4a2502aceaa9133afef552b567a19cb46e",
  "description": "Cross-component identity, state and authority contract. Lambda, gateway and worker must agree on these names and rules. The conformance checker uses this file to detect contradictions between component schemas and traces, so a component that renames an identity field or permits an illegal transition fails the check rather than surfacing at integration.",
  "design_reference": "implementation-design.md#5-public-contract-and-identity",
  "identifiers": {
    "task_id": {
      "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "form": "tsk_<UUIDv4>",
      "opaque": true,
      "description": "Stable task handle. Survives worker replacement and generation change."
    },
    "invocation_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "form": "UUIDv4",
      "opaque": true,
      "description": "One invocation per task in v1. Not an SQS receipt or transport identifier."
    },
    "command_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "form": "UUIDv4",
      "opaque": true,
      "description": "Unique across input and cancellation within its task. Reuse with another kind or different payload conflicts."
    },
    "artifact_id": {
      "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "form": "art_<UUIDv4>",
      "opaque": true
    },
    "dispatch_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "form": "UUIDv4",
      "description": "Stable FIFO dispatch UUID, used as MessageDeduplicationId."
    },
    "runtime_attempt_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "form": "UUIDv4",
      "nullable": true,
      "description": "In-process attempt identity. An in-process attempt change never impersonates a new generation."
    },
    "turn_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "form": "UUIDv4",
      "description": "Model operation identity. One model operation per turn."
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "description": "Worker registration generation. Increments only on verified worker replacement."
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "description": "Task-level positive-integer event ordering number."
    },
    "event_cursor": {
      "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}:[1-9][0-9]*$",
      "form": "<task_id>:<sequence>",
      "description": "Cursors confer no read authority."
    }
  },
  "separated_identities": {
    "must_remain_distinct": [
      "task_id",
      "invocation_id",
      "generation",
      "runtime_attempt_id",
      "command_id",
      "turn_id"
    ],
    "rationale": "design section 5 Runtime identities: keeping these separate is what lets recovery preserve the task handle while invalidating a replaced worker's authority.",
    "pod_uid_is_internal": true,
    "public_api_accepts_pod_targets": false,
    "transport_id_may_substitute_run_id": false
  },
  "canonical_principal": {
    "resolution": "exact tenant + alias_source + alias_id lookup in the canonical principal service",
    "alias_source": "cognito_m2m",
    "permitted_fallbacks": [],
    "forbidden_fallbacks": [
      "sub",
      "body service name",
      "legacy EventBridge alias"
    ],
    "caller_supplied_scope_honoured": false,
    "caller_supplied_fields_rejected": [
      "tenant",
      "tenant_id",
      "owner",
      "canonical_principal",
      "executable",
      "model",
      "model_override",
      "generation",
      "runtime_attempt_id",
      "invocation_id",
      "queue",
      "grant",
      "dispatch_id",
      "transport_credentials"
    ],
    "github_identity_grants_task_access": false,
    "fabricated_github_installation_permitted": false,
    "human_control_impersonation_permitted": false
  },
  "ownership": {
    "v1_access_model": "service-owner-only",
    "same_tenant_nonowner_has_implicit_access": false,
    "cross_tenant_access": "denied",
    "public_delegation": false,
    "human_admin_override": false,
    "authority_checks_per_operation": [
      "active alias",
      "canonical principal",
      "task ownership",
      "current task policy"
    ],
    "stream_recheck_max_interval_seconds": 15,
    "revocation_close_within_seconds": 30,
    "unavailable_authorization_dependency": "deny new operations and close streams; never anonymous access"
  },
  "lifecycle": {
    "states": [
      "accepted",
      "queued",
      "running",
      "waiting_for_input",
      "cancel_requested",
      "completed",
      "failed",
      "cancelled"
    ],
    "initial_state": "accepted",
    "terminal_states": [
      "completed",
      "failed",
      "cancelled"
    ],
    "transitions": {
      "accepted": {
        "permitted": [
          "queued",
          "running",
          "cancel_requested",
          "failed"
        ],
        "evidence": {
          "queued": "confirmed publication",
          "running": "a valid consumer starts before the publisher records its acknowledgement",
          "failed": "definitive admission recovery exhaustion"
        }
      },
      "queued": {
        "permitted": [
          "running",
          "cancel_requested",
          "failed"
        ],
        "evidence": {
          "running": "protected bootstrap",
          "failed": "deadline or exhaustion with no active execution"
        }
      },
      "running": {
        "permitted": [
          "waiting_for_input",
          "cancel_requested",
          "completed",
          "failed"
        ],
        "evidence": {
          "completed": "committed result and validated process exit"
        }
      },
      "waiting_for_input": {
        "permitted": [
          "running",
          "cancel_requested",
          "failed"
        ],
        "evidence": {
          "running": "committed next turn",
          "failed": "deadline after confirmed stop"
        }
      },
      "cancel_requested": {
        "permitted": [
          "cancelled",
          "failed"
        ],
        "evidence": {
          "cancelled": "confirmed stop or proof no execution started",
          "failed": "separately proven terminal failure"
        }
      },
      "completed": {
        "permitted": [],
        "evidence": {}
      },
      "failed": {
        "permitted": [],
        "evidence": {}
      },
      "cancelled": {
        "permitted": [],
        "evidence": {}
      }
    },
    "invariants": [
      {
        "id": "LC-01",
        "rule": "cancel_requested never transitions to completed",
        "design_reference": "implementation-design.md#state-transitions",
        "owner": "T7"
      },
      {
        "id": "LC-02",
        "rule": "terminal states are immutable; later queue acknowledgement or cleanup evidence may be appended without changing the outcome",
        "design_reference": "implementation-design.md#state-transitions",
        "owner": "T1"
      },
      {
        "id": "LC-03",
        "rule": "task version is a compare-and-swap fence: if completion commits first, cancellation returns the existing completion; if cancellation commits first, completion is refused",
        "design_reference": "implementation-design.md#state-transitions",
        "owner": "T1"
      },
      {
        "id": "LC-04",
        "rule": "heartbeat loss sets execution_health=unknown and recovery_required=true; it never asserts exit and never changes the task to success",
        "design_reference": "implementation-design.md#state-transitions",
        "owner": "T4"
      },
      {
        "id": "LC-05",
        "rule": "completion requires both a committed result and a validated process exit",
        "design_reference": "implementation-design.md#state-transitions",
        "owner": "T4"
      },
      {
        "id": "LC-06",
        "rule": "a terminal task is never reopened by an idempotent retry of its original key",
        "design_reference": "implementation-design.md#5-public-contract-and-identity",
        "owner": "T1"
      },
      {
        "id": "LC-07",
        "rule": "pending input must be consumed or explicitly settled before terminal completion",
        "design_reference": "implementation-design.md#durable-input-and-the-meaning-of-consumption",
        "owner": "T7"
      },
      {
        "id": "LC-08",
        "rule": "unknown evidence is nullable, never zero or success; unknown model usage is never recorded as zero cost",
        "design_reference": "implementation-design.md#5-public-contract-and-identity",
        "owner": "T6"
      },
      {
        "id": "LC-09",
        "rule": "event sequence numbers strictly increase per task; failed transactions do not consume a sequence and unpersisted progress never receives a fabricated sequence",
        "design_reference": "implementation-design.md#6-storage-and-integrity",
        "owner": "T1"
      },
      {
        "id": "LC-10",
        "rule": "late progress or results from a fenced (superseded) generation cannot change the outcome",
        "design_reference": "implementation-design.md#cancellation-and-finalization",
        "owner": "T3"
      },
      {
        "id": "LC-11",
        "rule": "one command is appended once to the canonical conversation and included once in its assigned logical turn; this is the accepted consumption boundary and does not claim exactly-once provider execution",
        "design_reference": "implementation-design.md#durable-input-and-the-meaning-of-consumption",
        "owner": "T7"
      },
      {
        "id": "LC-12",
        "rule": "a possibly-sent model request stays handoff=unknown and is never automatically resent",
        "design_reference": "implementation-design.md#durable-input-and-the-meaning-of-consumption",
        "owner": "T6"
      },
      {
        "id": "LC-13",
        "rule": "an SQS acknowledgement is recorded only on confirmed delete; an attempted delete is recorded as unknown",
        "design_reference": "implementation-design.md#cancellation-and-finalization",
        "owner": "T3"
      },
      {
        "id": "LC-14",
        "rule": "intentional cancellation never enters the generic retry path or starts another attempt",
        "design_reference": "implementation-design.md#cancellation-and-finalization",
        "owner": "T7"
      }
    ]
  },
  "storage_records": {
    "table": "adp-<env>-webhook-events",
    "physical_keys": [
      "event_id",
      "arrived_at"
    ],
    "table_replaced": false,
    "required_attributes": [
      "record_type",
      "schema_version",
      "scope"
    ],
    "omitted_legacy_gsi_attributes": [
      "tenant_id",
      "user_id",
      "correlation_id",
      "root_human_id",
      "engine_command_status"
    ],
    "raw_invocation_id_as_partition": false,
    "activity_run_projection_in_v1": false,
    "records": [
      {
        "record": "task snapshot/counters",
        "record_type": "TASK",
        "event_id": "TASK#<task_id>",
        "arrived_at": "META"
      },
      {
        "record": "run history",
        "record_type": "TASK_RUN",
        "event_id": "TASK_RUN#<task_id>",
        "arrived_at": "RUN#<invocation_id>#GEN#<10-digit-generation>"
      },
      {
        "record": "ordered events",
        "record_type": "TASK_EVENTS",
        "event_id": "TASK_EVENTS#<task_id>",
        "arrived_at": "SEQ#<20-digit-sequence>"
      },
      {
        "record": "commands/receipts",
        "record_type": "TASK_COMMANDS",
        "event_id": "TASK_COMMANDS#<task_id>",
        "arrived_at": "CMD#<command_id>"
      },
      {
        "record": "canonical conversation",
        "record_type": "TASK_TURNS",
        "event_id": "TASK_TURNS#<task_id>",
        "arrived_at": "TURN#<20-digit-turn-number>"
      },
      {
        "record": "model operation/receipt",
        "record_type": "TASK_OPS",
        "event_id": "TASK_OPS#<task_id>",
        "arrived_at": "MODEL#<turn_id>"
      },
      {
        "record": "request idempotency",
        "record_type": "TASK_IDEMP",
        "event_id": "TASK_IDEMP#<SHA256(tenant,principal,key)>",
        "arrived_at": "META"
      },
      {
        "record": "publication/recovery",
        "record_type": "TASK_WORK",
        "event_id": "TASK_WORK#<task_id>",
        "arrived_at": "DISPATCH#<dispatch_id> or RECONCILE"
      },
      {
        "record": "producer event deduplication",
        "record_type": "TASK_REPORT",
        "event_id": "TASK_REPORT#<task_id>",
        "arrived_at": "REPORT#<generation>#<report_id>"
      },
      {
        "record": "artifact binding",
        "record_type": "TASK_ARTIFACT",
        "event_id": "TASK_ARTIFACT#<artifact_id>",
        "arrived_at": "META"
      }
    ],
    "authority_records": [
      {
        "record": "task policy",
        "pk": "TENANT#<tenant>",
        "sk": "TASK_POLICY#<canonical_principal>"
      },
      {
        "record": "task binding",
        "pk": "TENANT#<tenant>",
        "sk": "TASK#<task_id>"
      },
      {
        "record": "task run grant",
        "pk": "TENANT#<tenant>",
        "sk": "TASK_RUN#<invocation_id>#GEN#<10-digit-generation>"
      },
      {
        "record": "task capacity reservation",
        "pk": "TASK_CAPACITY#<scope-hash>",
        "sk": "ACTIVE"
      }
    ],
    "preserved_legacy_lookup": {
      "pk": "INVOCATION#<invocation_id>",
      "sk": "DISPATCH"
    },
    "work_index": {
      "name": "task-work-index",
      "partition_attribute": "task_work_shard",
      "partition_form": "v1#<00..15>",
      "shard_source": "task hash",
      "sort_attribute": "task_due",
      "sort_form": "fixed-width epoch milliseconds plus task/work ID",
      "sparse": true,
      "only_work_records_carry_fields": true,
      "table_scan_permitted": false,
      "index_lag_authorizes_mutation": false
    },
    "worker_direct_write_denied_prefixes": [
      "TASK#",
      "TASK_RUN#",
      "TASK_EVENTS#",
      "TASK_COMMANDS#",
      "TASK_TURNS#",
      "TASK_OPS#",
      "TASK_IDEMP#",
      "TASK_WORK#",
      "TASK_REPORT#",
      "TASK_ARTIFACT#"
    ],
    "deny_covers": [
      "Put",
      "Update",
      "Delete",
      "batch write",
      "transactional write"
    ],
    "deny_condition_operator": "ForAnyValue:StringLike on DynamoDB LeadingKeys",
    "sole_task_writer": "gateway",
    "lambda_has_authority_table_write": false,
    "legacy_adapters_reject_task_prefixes": true,
    "deputy_bypass_permitted": false
  },
  "digests": {
    "canonicalization": "RFC 8785 canonical JSON",
    "hash": "SHA-256",
    "component_encoding": "versioned length-delimited components, not ambiguous concatenation",
    "idempotency_scope": [
      "tenant",
      "canonical_principal",
      "idempotency_key"
    ],
    "external_reference_is_correlation_only": true,
    "producer_proof_binding": [
      "method",
      "route",
      "original token digest",
      "idempotency key",
      "exact request bytes"
    ]
  },
  "internal_routes": [
    {
      "route": "/internal/v1/tasks/admit",
      "contract_key": "admit",
      "request_schema": "internal-adapters.schema.json#/$defs/admit_request",
      "response_schema": "internal-adapters.schema.json#/$defs/admit_response",
      "owner": "T3",
      "caller": "ingress lambda",
      "purpose": "durable acceptance receipt from original submit body, key, token and producer proof"
    },
    {
      "route": "/internal/v1/tasks/dispatch/claim",
      "contract_key": "dispatch_claim",
      "request_schema": "internal-adapters.schema.json#/$defs/dispatch_claim_request",
      "response_schema": "internal-adapters.schema.json#/$defs/dispatch_claim_response",
      "owner": "T3",
      "caller": "ingress lambda",
      "purpose": "claimed immutable envelope and 45-second lease token after current policy checks"
    },
    {
      "route": "/internal/v1/tasks/dispatch/settle",
      "contract_key": "dispatch_settle",
      "request_schema": "internal-adapters.schema.json#/$defs/dispatch_settle_request",
      "response_schema": "internal-adapters.schema.json#/$defs/dispatch_settle_response",
      "owner": "T3",
      "caller": "ingress lambda",
      "purpose": "record publication evidence, not a caller-selected task state"
    },
    {
      "route": "/internal/v1/tasks/recovery/claim",
      "contract_key": "recovery_claim",
      "request_schema": "internal-adapters.schema.json#/$defs/recovery_claim_request",
      "response_schema": "internal-adapters.schema.json#/$defs/recovery_claim_response",
      "owner": "T3",
      "caller": "task-recovery alias",
      "purpose": "due leased work records, limit at most 100"
    },
    {
      "route": "/internal/v1/tasks/recovery/settle",
      "contract_key": "recovery_settle",
      "request_schema": "internal-adapters.schema.json#/$defs/recovery_settle_request",
      "response_schema": "internal-adapters.schema.json#/$defs/recovery_settle_response",
      "owner": "T3",
      "caller": "task-recovery alias",
      "purpose": "apply recovery transition after state/ownership validation"
    },
    {
      "route": "/internal/v1/agent/task/bootstrap",
      "contract_key": "bootstrap",
      "request_schema": "internal-adapters.schema.json#/$defs/bootstrap_request",
      "response_schema": "internal-adapters.schema.json#/$defs/bootstrap_response",
      "owner": "T4",
      "caller": "worker host",
      "purpose": "task-scoped run credential, immutable bindings and generation; no caller-selected owner"
    },
    {
      "route": "/internal/v1/agent/task/attempt",
      "contract_key": "attempt",
      "request_schema": "internal-adapters.schema.json#/$defs/attempt_request",
      "response_schema": "internal-adapters.schema.json#/$defs/attempt_response",
      "owner": "T4",
      "caller": "worker host",
      "purpose": "atomically replace current attempt after old endpoint invalidation"
    },
    {
      "route": "/internal/v1/agent/task/report",
      "contract_key": "report",
      "request_schema": "internal-adapters.schema.json#/$defs/report_request",
      "response_schema": "internal-adapters.schema.json#/$defs/report_response",
      "owner": "T6",
      "caller": "worker host",
      "purpose": "commit typed event, return sequence and receipt"
    },
    {
      "route": "/internal/v1/agent/task/turn",
      "contract_key": "turn",
      "request_schema": "internal-adapters.schema.json#/$defs/turn_request",
      "response_schema": "internal-adapters.schema.json#/$defs/turn_response",
      "owner": "T7",
      "caller": "worker host",
      "purpose": "atomically commit eligible input to a turn or return existing turn/input-wait state"
    },
    {
      "route": "/internal/v1/agent/task/model",
      "contract_key": "model",
      "request_schema": "internal-adapters.schema.json#/$defs/model_request",
      "response_schema": "internal-adapters.schema.json#/$defs/model_response",
      "owner": "T6",
      "caller": "worker host",
      "purpose": "one model operation per turn; returns stored result or operation receipt"
    },
    {
      "route": "/internal/v1/agent/task/control",
      "contract_key": "control",
      "request_schema": "internal-adapters.schema.json#/$defs/control_request",
      "response_schema": "internal-adapters.schema.json#/$defs/control_response",
      "owner": "T7",
      "caller": "worker host",
      "purpose": "durable cancel/input state, never arbitrary signed control authority"
    },
    {
      "route": "/internal/v1/agent/task/artifact",
      "contract_key": "artifact",
      "request_schema": "internal-adapters.schema.json#/$defs/artifact_request",
      "response_schema": "internal-adapters.schema.json#/$defs/artifact_response",
      "owner": "T6",
      "caller": "worker host",
      "purpose": "immutable task artifact reference from bounded bytes"
    },
    {
      "route": "/internal/v1/agent/task/finalize",
      "contract_key": "finalize",
      "request_schema": "internal-adapters.schema.json#/$defs/finalize_request",
      "response_schema": "internal-adapters.schema.json#/$defs/finalize_response",
      "owner": "T4",
      "caller": "worker host",
      "purpose": "terminal receipt after all fences and checks"
    },
    {
      "route": "/internal/v1/agent/task/settlement",
      "contract_key": "settlement",
      "request_schema": "internal-adapters.schema.json#/$defs/settlement_request",
      "response_schema": "internal-adapters.schema.json#/$defs/settlement_response",
      "owner": "T4",
      "caller": "bound workload",
      "purpose": "stop-only stop/ack evidence, valid after run-credential expiry"
    },
    {
      "route": "/internal/v1/agent/task/acquire",
      "contract_key": "acquire",
      "request_schema": "internal-adapters.schema.json#/$defs/empty_delivery_request",
      "response_schema": "internal-adapters.schema.json#/$defs/acquire_response",
      "owner": "T3",
      "caller": "worker",
      "purpose": "pre-existing protected queue acquisition. Retains its old-envelope behaviour; a narrow task-discriminator adapter enforces the same fences and returns a confirmed acknowledgement only after actual settlement. Listed for completeness against design section 12: T0 records it and changes nothing about it.",
      "pre_existing": true
    },
    {
      "route": "/internal/v1/agent/task/heartbeat",
      "contract_key": "heartbeat",
      "request_schema": "internal-adapters.schema.json#/$defs/empty_delivery_request",
      "response_schema": "internal-adapters.schema.json#/$defs/delivery_ack_response",
      "owner": "T3",
      "caller": "worker",
      "purpose": "pre-existing protected queue visibility heartbeat with empty body and confirmed acknowledgement",
      "pre_existing": true
    },
    {
      "route": "/internal/v1/agent/task/ack",
      "contract_key": "ack",
      "request_schema": "internal-adapters.schema.json#/$defs/empty_delivery_request",
      "response_schema": "internal-adapters.schema.json#/$defs/delivery_ack_response",
      "owner": "T3",
      "caller": "worker",
      "purpose": "pre-existing protected queue acknowledgement after actual settlement with empty body and confirmed acknowledgement",
      "pre_existing": true
    }
  ],
  "preserved_internal_routes": [
    "/internal/v1/agent/task/acquire",
    "/internal/v1/agent/task/heartbeat",
    "/internal/v1/agent/task/ack"
  ],
  "internal_route_rules": {
    "unknown_fields_rejected": true,
    "run_routes_require": [
      "IAM transport",
      "run credential",
      "live TokenReview binding"
    ],
    "gateway_derives": [
      "tenant",
      "task",
      "run",
      "generation"
    ],
    "command_may_supply_other_task_id": false
  },
  "public_routes": [
    {
      "route": "POST /v1/tasks",
      "owner": "T2",
      "scope": "adp-tasks/submit"
    },
    {
      "route": "GET /v1/tasks/{task_id}",
      "owner": "T6",
      "scope": "adp-tasks/read"
    },
    {
      "route": "GET /v1/tasks/{task_id}/events",
      "owner": "T6",
      "scope": "adp-tasks/read"
    },
    {
      "route": "POST /v1/tasks/{task_id}/messages",
      "owner": "T7",
      "scope": "adp-tasks/input"
    },
    {
      "route": "POST /v1/tasks/{task_id}/cancel",
      "owner": "T7",
      "scope": "adp-tasks/cancel"
    },
    {
      "route": "POST /v1/task-artifacts",
      "owner": "T6",
      "scope": "adp-tasks/artifacts"
    },
    {
      "route": "GET /v1/tasks/{task_id}/artifacts/{artifact_id}",
      "owner": "T6",
      "scope": "adp-tasks/artifacts + adp-tasks/read"
    }
  ],
  "event_kinds": [
    "task.accepted",
    "task.queued",
    "run.started",
    "progress.updated",
    "artifact.created",
    "input.required",
    "input.accepted",
    "input.consumed",
    "input.rejected",
    "command.updated",
    "cancel.requested",
    "run.completed",
    "run.failed",
    "task.completed",
    "task.failed",
    "task.cancelled",
    "history.gap"
  ],
  "process_protocol": {
    "protocol_version": 1,
    "encoding": "one JSON object per newline, incremental",
    "host_to_child_types": [
      "start",
      "turn",
      "model.result",
      "report.ack",
      "cancel"
    ],
    "child_to_host_types": [
      "ready",
      "progress",
      "model.request",
      "input.required",
      "result",
      "cancelled",
      "error"
    ],
    "stdout_is_protocol_only": true,
    "stderr_is_bounded_sanitized_diagnostic": true,
    "host_may_buffer_until_exit": false,
    "failure_conditions": [
      "invalid protocol",
      "identity mismatch",
      "missing valid final result"
    ],
    "advertised_capabilities": [
      "input",
      "cancel"
    ],
    "v1_excluded_capabilities": [
      "pause",
      "resume"
    ],
    "human_control_routes_exposed_to_service_tokens": false
  },
  "dispatch_envelope": {
    "kind": "adp.task",
    "schema_version": "1.0",
    "message_group_id_source": "hash of tenant + task",
    "message_deduplication_id_source": "stable dispatch UUID",
    "message_id_equals": "invocation_id",
    "message_id_is_sqs_receipt": false,
    "producer_persists_digest_before_publication": true,
    "sqs_dedup_window_equals_task_idempotency_window": false
  },
  "error_codes": {
    "400": [
      "invalid_request",
      "invalid_cursor"
    ],
    "401": [
      "invalid_credential"
    ],
    "403": [
      "disallowed_scope",
      "disallowed_persona"
    ],
    "404": [
      "not_found"
    ],
    "409": [
      "idempotency_conflict",
      "command_conflict",
      "state_conflict"
    ],
    "410": [
      "history_expired"
    ],
    "413": [
      "payload_too_large"
    ],
    "429": [
      "rate_limited",
      "queue_full"
    ],
    "503": [
      "prerequisite_unavailable"
    ],
    "retryable": [
      "429",
      "503"
    ],
    "retry_preserves_original_intent_id": true,
    "timeout_permits_fresh_intent": false
  },
  "pre_existing_routes_unchanged": {
    "routes": [
      "/internal/v1/agent/task/acquire",
      "/internal/v1/agent/task/heartbeat",
      "/internal/v1/agent/task/ack"
    ],
    "rule": "These keep their current old-envelope behaviour. The task path adds a discriminator adapter rather than modifying them, which is what makes the legacy fixtures a meaningful regression baseline.",
    "design_reference": "implementation-design.md section 12"
  }
