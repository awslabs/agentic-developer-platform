{
  "contract_version": "1.0",
  "design_revision": "b5761a4a2502aceaa9133afef552b567a19cb46e",
  "design_reference": "implementation-design.md#10-fixed-pilot-limits-and-evidence-thresholds",
  "description": "Fixed pilot limits and evidence thresholds, encoded before implementation measurements. These are accepted baseline limits, not observed performance and not authorization to spend. Existing stricter tenant/platform policy wins. Raising any value requires a reviewed design/configuration change before new acceptance measurements; an evaluator cannot relax a value after observing a failure.",
  "amendment_rule": "Raising a limit requires a reviewed design change. An evaluator observing a failure records FAIL, not a looser limit.",
  "submit_body": {
    "max_body_bytes": 65536,
    "body_bytes_unit": "UTF-8 encoded JSON bytes",
    "max_instructions_characters": 16000,
    "max_external_reference_characters": 256,
    "max_acceptance_criteria_count": 10,
    "max_acceptance_criterion_characters": 1000,
    "idempotency_key_min_characters": 1,
    "idempotency_key_max_characters": 128,
    "idempotency_key_charset": "printable ASCII"
  },
  "artifacts": {
    "max_input_artifacts": 4,
    "max_input_artifact_bytes": 262144,
    "max_input_artifacts_total_bytes": 1048576,
    "max_result_artifacts_total_bytes": 1048576,
    "permitted_content_types_investigator_v1": ["text/plain", "application/json"],
    "unclaimed_upload_expiry_hours": 24,
    "max_run_artifact_bytes": 16777216
  },
  "commands": {
    "max_message_characters": 4000,
    "max_cancel_reason_characters": 1000,
    "max_command_bytes": 16384,
    "max_pending_inputs": 10,
    "reserved_cancel_slots": 1,
    "max_input_commands_per_task": 100
  },
  "process_and_reporting": {
    "max_frame_bytes": 65536,
    "max_progress_event_bytes": 8192,
    "sustained_progress_reports_per_second": 1,
    "burst_progress_reports_per_second": 5,
    "max_events_per_task": 10000,
    "reserved_terminal_event_slots": 100,
    "host_buffer_max_nonterminal_reports": 128,
    "host_buffer_max_bytes": 262144,
    "host_buffer_max_seconds": 10
  },
  "sse": {
    "max_streams_per_task": 2,
    "max_streams_per_principal": 10,
    "max_streams_per_environment": 32,
    "max_buffered_frames_per_stream": 100,
    "max_buffered_bytes_per_stream": 262144,
    "blocked_write_disconnect_seconds": 10,
    "event_page_size": 100,
    "active_reader_poll_interval_seconds": 1,
    "heartbeat_interval_seconds": 15,
    "connection_window_minutes": 10,
    "api_gateway_limit_minutes": 15
  },
  "submit_rate_and_capacity": {
    "max_new_tasks_per_minute_per_principal": 10,
    "max_nonterminal_tasks_per_tenant": 20,
    "max_executing_tasks_per_principal": 2,
    "max_executing_tasks_per_tenant": 4,
    "max_executing_tasks_pilot_wide": 4,
    "idempotent_retry_reserves_slot": false
  },
  "lifetime": {
    "task_lifetime_minutes": 360,
    "lifetime_includes_queue_and_input_waits": true,
    "max_model_turns": 8,
    "max_provider_operation_seconds": 120,
    "max_model_output_tokens_per_turn": 4096
  },
  "spend": {
    "max_usd_per_task": 1,
    "max_usd_per_tenant_per_day": 10,
    "max_usd_entire_qualification_run": 25,
    "enforcement": "existing budget authority plus per-call upper-bound reservation",
    "deny_when_pricing_unavailable": true,
    "separate_from_engine_development_budget": true
  },
  "reporting_and_access": {
    "required_distinct_authored_progress_markers": 2,
    "max_external_marker_arrival_seconds": 5,
    "marker_condition": "controlled healthy fixture held open; each of two distinct authored updates delivered within five seconds",
    "heartbeat_only_satisfies_progress": false,
    "buffered_final_stdout_satisfies_progress": false,
    "revocation_stream_close_seconds": 30,
    "queued_input_revalidated_immediately_before_handoff": true,
    "stream_authorization_recheck_max_interval_seconds": 15
  },
  "heartbeat_and_cancellation": {
    "host_heartbeat_interval_seconds": 30,
    "sqs_visibility_timeout_seconds": 300,
    "healthy_host_observes_cancel_within_seconds": 5,
    "confirm_child_stop_within_seconds": 30,
    "process_group_termination_at_seconds": 20,
    "force_kill_at_seconds": 30,
    "control_poll_interval_seconds": 1,
    "uncertainty_required_when_unconfirmed": true
  },
  "recovery": {
    "schedule_interval_seconds": 60,
    "healthy_pending_dispatch_rediscovery_seconds": 120,
    "max_work_records_per_invocation": 100,
    "max_invocation_seconds": 30,
    "work_lease_seconds": 45,
    "max_publication_tries": 5,
    "publication_try_window_minutes": 10,
    "max_pre_model_generations_per_task": 3,
    "all_bounded_by_task_deadline": true
  },
  "retention": {
    "ttl_on_active_records": false,
    "no_ttl_record_types": [
      "active task",
      "grant",
      "idempotency",
      "command",
      "referenced artifact"
    ],
    "content_retention_days_after_terminal": 30,
    "tombstone_retention_days": 90,
    "tombstone_response_code": 410,
    "key_reuse_permitted_after_days": 90,
    "recovery_required_tasks_retained_until_settlement": true
  },
  "coexistence_thresholds": {
    "min_bounded_legacy_observations": 10,
    "observation_window": "before and during the pilot",
    "max_new_task_caused_legacy_routing_or_auth_failures": 0,
    "max_lambda_throttles": 0,
    "max_legacy_p95_latency_increase_percent": 20,
    "max_legacy_p95_latency_increase_absolute_seconds": 1,
    "latency_increase_rule": "whichever of percent or absolute is larger",
    "queue_age_return_to_baseline_minutes": 5,
    "small_sample_is_production_slo_claim": false
  }
}
