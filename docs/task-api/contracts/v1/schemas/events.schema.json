{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.schema.json",
  "title": "Task API durable event and SSE frame contract v1",
  "description": "The durable progress record and the SSE frames delivered from it. Every event is persisted before delivery and shares a transaction with the state transition it reports, so an event appearing in a trace is a claim that the state change committed. Diagnostic content is allowlisted and sanitized. Design revision b5761a4a2502aceaa9133afef552b567a19cb46e, design section 9.",
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "invocation_id",
        "generation",
        "runtime_attempt_id",
        "sequence",
        "event_id",
        "type",
        "timestamp",
        "data"
      ],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
        "task_id": { "$ref": "common.schema.json#/$defs/task_id" },
        "invocation_id": { "$ref": "common.schema.json#/$defs/invocation_id" },
        "generation": { "$ref": "common.schema.json#/$defs/generation" },
        "runtime_attempt_id": { "$ref": "common.schema.json#/$defs/runtime_attempt_id" },
        "sequence": { "$ref": "common.schema.json#/$defs/sequence" },
        "event_id": {
          "$ref": "common.schema.json#/$defs/event_cursor",
          "description": "<task_id>:<sequence>. Clients deduplicate by this value."
        },
        "type": { "$ref": "events.schema.json#/$defs/event_type" },
        "timestamp": {
          "$ref": "common.schema.json#/$defs/timestamp",
          "description": "Server timestamp."
        },
        "producer_timestamp": {
          "$ref": "common.schema.json#/$defs/nullable_timestamp",
          "description": "Optional emitter timestamp. Both are measured when qualifying the two-marker latency threshold."
        },
        "data": { "$ref": "events.schema.json#/$defs/event_data" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["task.accepted", "task.queued", "run.started"] } }, "required": ["type"] },
          "then": { "properties": { "data": { "required": ["status", "version"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "progress.updated" } }, "required": ["type"] },
          "then": { "properties": { "data": { "required": ["message", "stage"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "artifact.created" } }, "required": ["type"] },
          "then": { "properties": { "data": { "required": ["artifact_id", "content_sha256"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "input.required" } }, "required": ["type"] },
          "then": { "properties": { "data": { "required": ["input_request_id", "prompt"] } } }
        },
        {
          "if": { "properties": { "type": { "enum": ["input.accepted", "input.rejected", "command.updated"] } }, "required": ["type"] },
          "then": { "properties": { "data": { "required": ["command_id", "command_status", "handoff"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "input.consumed" } }, "required": ["type"] },
          "then": { "properties": { "data": { "required": ["command_id", "command_status", "handoff", "turn_id", "turn_number"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "cancel.requested" } }, "required": ["type"] },
          "then": { "properties": { "data": { "required": ["command_id", "status", "version"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "run.completed" } }, "required": ["type"] },
          "then": { "properties": { "data": { "required": ["outcome"], "properties": { "outcome": { "const": "completed" } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "run.failed" } }, "required": ["type"] },
          "then": { "properties": { "data": { "required": ["outcome", "error_code"], "properties": { "outcome": { "const": "failed" } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "task.completed" } }, "required": ["type"] },
          "then": { "properties": { "data": { "required": ["status", "version", "outcome"], "properties": { "status": { "const": "completed" }, "outcome": { "const": "completed" } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "task.failed" } }, "required": ["type"] },
          "then": { "properties": { "data": { "required": ["status", "version", "outcome", "error_code"], "properties": { "status": { "const": "failed" }, "outcome": { "const": "failed" } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "task.cancelled" } }, "required": ["type"] },
          "then": { "properties": { "data": { "required": ["status", "version", "outcome"], "properties": { "status": { "const": "cancelled" }, "outcome": { "const": "cancelled" } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "history.gap" } }, "required": ["type"] },
          "then": { "properties": { "data": { "required": ["omitted_from_cursor", "omitted_to_cursor", "omitted_report_ids", "reason"] } } }
        }
      ]
    },

    "event_type": {
      "enum": [
        "task.accepted",
        "task.queued",
        "run.started",
        "progress.updated",
        "artifact.created",
        "input.required",
        "input.accepted",
        "input.consumed",
        "input.rejected",
        "command.updated",
        "cancel.requested",
        "run.completed",
        "run.failed",
        "task.completed",
        "task.failed",
        "task.cancelled",
        "history.gap"
      ]
    },

    "event_data": {
      "type": "object",
      "additionalProperties": false,
      "description": "Allowlisted data object. No free-form passthrough, no private model reasoning, no fabricated completion percentage.",
      "properties": {
        "status": { "$ref": "common.schema.json#/$defs/task_status" },
        "version": { "$ref": "common.schema.json#/$defs/task_version" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "Authored progress text naming evidence inspected or findings so far."
        },
        "stage": {
          "enum": ["evidence_inventory", "analysis", "clarification", "synthesis"],
          "description": "Investigator v1 stages from design section 3."
        },
        "command_id": { "$ref": "common.schema.json#/$defs/command_id" },
        "command_status": { "$ref": "common.schema.json#/$defs/command_status" },
        "handoff": { "$ref": "common.schema.json#/$defs/handoff_status" },
        "turn_number": { "type": "integer", "minimum": 1 },
        "turn_id": { "$ref": "common.schema.json#/$defs/turn_id" },
        "input_request_id": { "$ref": "common.schema.json#/$defs/uuid4" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "artifact_id": { "$ref": "common.schema.json#/$defs/artifact_id" },
        "content_sha256": { "$ref": "common.schema.json#/$defs/sha256_digest" },
        "dispatch_id": { "$ref": "common.schema.json#/$defs/dispatch_id" },
        "outcome": { "$ref": "common.schema.json#/$defs/terminal_task_status" },
        "error_code": { "$ref": "results.schema.json#/$defs/failure_code" },
        "reason": { "$ref": "common.schema.json#/$defs/safe_message" },
        "execution_health": { "$ref": "common.schema.json#/$defs/execution_health" },
        "recovery_required": { "type": "boolean" },
        "queue_ack_status": { "$ref": "common.schema.json#/$defs/queue_ack_status" },
        "omitted_from_cursor": { "$ref": "common.schema.json#/$defs/event_cursor" },
        "omitted_to_cursor": { "$ref": "common.schema.json#/$defs/event_cursor" },
        "omitted_report_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/report_id" },
          "description": "history.gap identifies the omitted producer reports rather than silently losing them."
        }
      }
    },

    "sse_snapshot_frame": {
      "type": "object",
      "description": "Sent first on a fresh SSE connection. A snapshot frame does not advance Last-Event-ID; only durable events do.",
      "additionalProperties": false,
      "required": ["schema_version", "frame", "task_id", "version", "status", "high_water_cursor", "oldest_event_cursor"],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
        "frame": { "const": "snapshot" },
        "task_id": { "$ref": "common.schema.json#/$defs/task_id" },
        "version": { "$ref": "common.schema.json#/$defs/task_version" },
        "status": { "$ref": "common.schema.json#/$defs/task_status" },
        "high_water_cursor": { "$ref": "common.schema.json#/$defs/nullable_event_cursor" },
        "oldest_event_cursor": { "$ref": "common.schema.json#/$defs/nullable_event_cursor" },
        "advances_last_event_id": {
          "const": false,
          "description": "Fixed false. A snapshot frame must never be treated as a durable event cursor."
        }
      }
    },

    "sse_event_frame": {
      "type": "object",
      "description": "A durable event delivered over SSE. id is the event cursor and does advance Last-Event-ID.",
      "additionalProperties": false,
      "required": ["frame", "id", "event"],
      "properties": {
        "frame": { "const": "event" },
        "id": { "$ref": "common.schema.json#/$defs/event_cursor" },
        "event": { "$ref": "events.schema.json#/$defs/event" }
      }
    },

    "sse_heartbeat_frame": {
      "type": "object",
      "description": "Comment heartbeat every 15 seconds. Heartbeat traffic alone can never satisfy the progress latency threshold.",
      "additionalProperties": false,
      "required": ["frame", "timestamp"],
      "properties": {
        "frame": { "const": "heartbeat" },
        "timestamp": { "$ref": "common.schema.json#/$defs/timestamp" },
        "counts_as_progress": { "const": false }
      }
    }
  }
}
