{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.schema.json",
  "title": "Task dispatch envelope contract v1",
  "description": "The message the gateway commits and the ingress Lambda publishes to the existing shared SQS queue. Its message_id is deliberately the ADP invocation ID rather than any transport identifier, because a transport ID surfacing as a run handle is one of the specific confusions the design forbids. The legacy envelope schema alongside this one is what lets a later evaluator prove existing GitHub messages still validate unchanged. Design revision b5761a4a2502aceaa9133afef552b567a19cb46e, design section 7.",
  "$defs": {
    "task_dispatch_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "task_id",
        "invocation_id",
        "message_id",
        "persona",
        "dispatch_id",
        "request_digest",
        "input_ref",
        "assignment_ref"
      ],
      "properties": {
        "kind": {
          "const": "adp.task",
          "description": "The discriminator the worker's task branch matches before any GitHub preparation."
        },
        "schema_version": {
          "$ref": "common.schema.json#/$defs/schema_version"
        },
        "task_id": {
          "$ref": "common.schema.json#/$defs/task_id"
        },
        "invocation_id": {
          "$ref": "common.schema.json#/$defs/invocation_id"
        },
        "message_id": {
          "$ref": "common.schema.json#/$defs/invocation_id",
          "description": "Equals invocation_id: the existing protected receive adapter's identifier. Not an SQS receipt or transport ID."
        },
        "persona": {
          "$ref": "common.schema.json#/$defs/persona"
        },
        "dispatch_id": {
          "$ref": "common.schema.json#/$defs/dispatch_id"
        },
        "request_digest": {
          "$ref": "common.schema.json#/$defs/sha256_digest"
        },
        "input_ref": {
          "$ref": "envelope.schema.json#/$defs/immutable_input_ref",
          "description": "Immutable reference to committed input. The envelope carries no raw credential."
        },
        "assignment_ref": {
          "$ref": "envelope.schema.json#/$defs/assignment_ref",
          "description": "Protected assignment reference. Body fields do not select authority."
        }
      },
      "not": {
        "description": "An envelope must never carry transport, credential or caller-selected authority fields.",
        "anyOf": [
          {
            "required": [
              "receipt_handle"
            ]
          },
          {
            "required": [
              "sqs_message_id"
            ]
          },
          {
            "required": [
              "run_credential"
            ]
          },
          {
            "required": [
              "token"
            ]
          },
          {
            "required": [
              "tenant_id"
            ]
          },
          {
            "required": [
              "repository"
            ]
          },
          {
            "required": [
              "installation_id"
            ]
          },
          {
            "required": [
              "issue_number"
            ]
          }
        ]
      }
    },
    "immutable_input_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "input_digest"
      ],
      "properties": {
        "record_type": {
          "const": "TASK"
        },
        "input_digest": {
          "$ref": "common.schema.json#/$defs/sha256_digest"
        },
        "artifact_refs": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "version",
              "content_sha256"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "common.schema.json#/$defs/artifact_id"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "content_sha256": {
                "$ref": "common.schema.json#/$defs/sha256_digest"
              }
            }
          },
          "description": "Digest and version pinned at admission."
        }
      }
    },
    "assignment_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_pk",
        "grant_sk",
        "generation"
      ],
      "properties": {
        "grant_pk": {
          "type": "string",
          "pattern": "^TENANT#"
        },
        "grant_sk": {
          "type": "string",
          "pattern": "^TASK_RUN#[0-9a-f-]{36}#GEN#[0-9]{10}$",
          "description": "Ten-digit zero-padded generation, matching the authority record layout."
        },
        "generation": {
          "$ref": "common.schema.json#/$defs/generation"
        }
      }
    },
    "sqs_publish_attributes": {
      "type": "object",
      "description": "FIFO publish attributes. The SQS deduplication window is not the task's idempotency window.",
      "additionalProperties": false,
      "required": [
        "MessageGroupId",
        "MessageDeduplicationId"
      ],
      "properties": {
        "MessageGroupId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Hash of tenant + task."
        },
        "MessageDeduplicationId": {
          "$ref": "common.schema.json#/$defs/dispatch_id",
          "description": "The stable dispatch UUID."
        }
      }
    },
    "legacy_github_envelope": {
      "type": "object",
      "description": "Reference shape for an existing webhook-path message on the shared queue, transcribed from WebhookEnvelope.to_dict() in modules/agent-factory/webhook-ingress/lambda/common/envelope.py. Included so an evaluator has a fixed baseline proving legacy messages keep validating unchanged and are never matched by the task branch. T0 does not own or change this contract; it records the discriminating fields only. Note the routing identifiers are nested under source_ref, not top level -- a task envelope forbids them at any depth.",
      "required": [
        "version",
        "channel",
        "tenant_id",
        "persona",
        "source_ref",
        "intent",
        "payload"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "channel": {
          "type": "string",
          "description": "github, slack or another source channel. Never adp.task."
        },
        "tenant_id": {
          "type": "string",
          "description": "Present and caller-resolved on the legacy path. The task path deliberately forbids it in the envelope, which is why the two schemas differ here rather than being unified."
        },
        "persona": {
          "type": "string",
          "not": {
            "pattern": "^agent-task-"
          },
          "description": "Legacy personas are never agent-task-*; an unknown task persona must not fall through to the legacy branch."
        },
        "source_ref": {
          "type": "object",
          "required": [
            "installation_id",
            "repo"
          ],
          "properties": {
            "installation_id": {
              "type": [
                "integer",
                "string"
              ]
            },
            "repo": {
              "type": "string"
            },
            "issue": {
              "type": [
                "integer",
                "null"
              ]
            },
            "pr": {
              "type": [
                "integer",
                "null"
              ]
            },
            "sha": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "intent": {
          "type": "object",
          "required": [
            "trigger",
            "persona"
          ],
          "properties": {
            "trigger": {
              "type": "string"
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "persona": {
              "type": "string"
            }
          }
        },
        "actor": {
          "type": "object"
        },
        "correlation": {
          "type": "object"
        },
        "payload": {
          "type": "object"
        },
        "arrived_at": {
          "type": "string"
        },
        "model_requested": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_resolved": {
          "type": [
            "string",
            "null"
          ]
        },
        "aws_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "token_source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "not": {
        "description": "A legacy envelope must never carry the task discriminator or a task run handle.",
        "anyOf": [
          {
            "properties": {
              "kind": {
                "const": "adp.task"
              }
            },
            "required": [
              "kind"
            ]
          },
          {
            "required": [
              "task_id"
            ]
          }
        ]
      }
    }
  }
}
