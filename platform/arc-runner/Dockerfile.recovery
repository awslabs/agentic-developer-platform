# Emergency runner refresh using the already deployed tool image. No rolling
# package repositories are needed. The normal Dockerfile remains the full build.
FROM ghcr.io/actions/actions-runner:2.337.0 AS runner_release
FROM 879318057152.dkr.ecr.us-east-1.amazonaws.com/adp-arc-runner@sha256:f7f3021f05b717009bd2a67a55521033334d4479a1e16801646c1dd9f3014ef1

USER root
RUN rm -rf /home/runner/bin /home/runner/externals
COPY --from=runner_release --chown=runner:runner /home/runner/ /home/runner/
USER runner
RUN runner_version_output=$(/home/runner/bin/Runner.Listener --version) \
    && printf '%s\n' "$runner_version_output" | grep -x '2\.337\.0' \
    && node --version \
    && python3 --version \
    && aws --version \
    && terraform version \
    && kubectl version --client \
    && helm version \
    && gh --version \
    && docker --version \
    && jq --version \
    && zip -v | head -1 \
    && /kaniko/executor version \
    && echo '=== All tools verified ==='
