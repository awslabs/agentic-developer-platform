FROM public.ecr.aws/docker/library/python:3.14.7-slim-trixie@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d AS python314-expat
RUN apt-get update && apt-get install -y --no-install-recommends build-essential binutils && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends cmake && rm -rf /var/lib/apt/lists/*
ADD --checksum=sha256:fd022c541a189bd5bee042a22188351b31e39b9389c2525fa98c28bd05c9ef21 https://deb.debian.org/debian/pool/main/e/expat/expat_2.8.5.orig.tar.gz /tmp/expat.tar.gz
RUN mkdir /src && tar -xzf /tmp/expat.tar.gz --strip-components=1 -C /src && cmake -S /src/expat -B /build -DEXPAT_SHARED_LIBS=OFF -DEXPAT_BUILD_TESTS=OFF -DEXPAT_BUILD_EXAMPLES=OFF -DEXPAT_BUILD_TOOLS=OFF -DEXPAT_BUILD_DOCS=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DCMAKE_INSTALL_PREFIX=/opt/expat/usr -DCMAKE_INSTALL_LIBDIR=lib/x86_64-linux-gnu && cmake --build /build -j2 && cmake --install /build
ADD --checksum=sha256:3b48dac8fb59f62eaa67ac83c1eb12bda1b7a08406dd286e252c11a66be27f81 https://www.python.org/ftp/python/3.14.7/Python-3.14.7.tar.xz /tmp/Python-3.14.7.tar.xz
COPY security/high-tools/build-python314-expat.py /tmp/build-python314-expat.py
ARG ADP_SOURCE_COMMIT
ENV ADP_SOURCE_COMMIT=${ADP_SOURCE_COMMIT}
RUN python /tmp/build-python314-expat.py /tmp/Python-3.14.7.tar.xz /opt/expat /out && mkdir /out/licenses && cp /src/expat/COPYING /out/licenses/expat-COPYING && cp /out/source/Python-3.14.7/LICENSE /out/licenses/python-LICENSE

# Build-only adapter artifact. This is not a deployable runner/application.
FROM scratch
USER 65532:65532
COPY --from=python314-expat /out/modules /modules
COPY --from=python314-expat /out/licenses /licenses
COPY --from=python314-expat /out/manifest.json /manifest.json
