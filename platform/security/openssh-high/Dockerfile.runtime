FROM 879318057152.dkr.ecr.us-east-1.amazonaws.com/adp-superplane-skypilot@sha256:2ea72b3f76d6e2f8b584c9ec780811a14bc94dc983d94382bc751363bb59a020 AS packages
FROM 879318057152.dkr.ecr.us-east-1.amazonaws.com/adp-superplane-skypilot@sha256:b12f257ef5b5997b68d38798ac99d5257a5ca00855b5c072911f408d8bbdd1de
USER root
COPY --from=packages /out/openssh-client_10.0p1-7+deb13u4+adp.security.2_amd64.deb /tmp/adp-openssh/client.deb
COPY --from=packages /out/openssh-server_10.0p1-7+deb13u4+adp.security.2_amd64.deb /tmp/adp-openssh/server.deb
COPY --from=packages /out/openssh-sftp-server_10.0p1-7+deb13u4+adp.security.2_amd64.deb /tmp/adp-openssh/sftp-server.deb
COPY platform/security/openssh-high/install.py /tmp/adp-openssh/install.py
RUN python /tmp/adp-openssh/install.py
COPY --from=packages /out/source-lock.json /out/NOTICE /out/patched-source-sha256.txt /opt/adp-openssh-security/
COPY --from=packages /out/source-authentication/ /opt/adp-openssh-security/source-authentication/
USER 1000:1000
