# Coverage scope for the live-control evaluation harness (Issue #3960).
#
# Needed because `agent-control-eval.py` is a hyphenated executable, not an
# importable module: `--cov=agent-control-eval` collects nothing, since coverage
# cannot import that name to locate it, and `--cov=.` collects the whole
# platform/scripts tree — which would make `--cov-fail-under` a statement about
# forty unrelated shell-adjacent scripts rather than about this harness.
#
# `include` (not `source`) with an explicit path is what pins measurement to the
# one file, so the >=85% gate in .github/workflows/agent-control-ci.yml means what
# it says.

[run]
branch = True
include =
    */platform/scripts/agent-control-eval.py

[report]
show_missing = True
# Exclude the __main__ guard only: it is one unreachable-under-test line, and
# excluding it keeps the threshold honest about the code that has behaviour.
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
