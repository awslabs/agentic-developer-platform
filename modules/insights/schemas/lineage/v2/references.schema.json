{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "record_ref": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "source_connection_id": {
          "type": "string",
          "minLength": 1
        },
        "record_type": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "record_revision": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "latest",
              "null"
            ]
          }
        }
      },
      "required": [
        "tenant_id",
        "project_id",
        "source_connection_id",
        "record_type",
        "record_id",
        "record_revision"
      ],
      "additionalProperties": false
    },
    "artifact_ref": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "latest",
              "null"
            ]
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "version_id",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
