{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test Run (section 3.8)",
  "allOf": [{"$ref": "envelope.schema.json"}],
  "type": "object",
  "properties": {
    "test_run_id": {"type": "string", "minLength": 1},
    "test_id": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "minLength": 1},
    "build_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string"},
    "result": {"type": "string"},
    "duration_ms": {"type": "number", "minimum": 0},
    "retry_index": {"type": "integer", "minimum": 0},
    "initial_result": {"type": "string"},
    "report_ref": {"type": "string"}
  },
  "required": ["test_run_id", "test_id", "commit_sha", "build_id"],
  "unevaluatedProperties": false
}
