{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/insights/results/v1/dataset-policy.schema.json",
  "title": "Qualified shared Insights result dataset policy 1.0",
  "description": "Stored at the trusted Project policy key. Snapshot SHA-256 covers sorted-key compact JSON with NaN forbidden; this descriptor is not a grant and readers must rederive current authority before load and release.",
  "type": "object",
  "properties": {
    "schema_version": {"const": "results-policy/1.0"},
    "tenant_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "dataset_version": {"$ref": "#/$defs/id"},
    "snapshot_sha256": {"$ref": "#/$defs/digest"},
    "policy_epoch": {"type": "integer", "minimum": 1, "description": "Matches the active shared cell routing revision."},
    "envelopes": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "envelope_version": {"const": 1},
          "identity": {"$ref": "#/$defs/identity"},
          "realm_id": {"$ref": "#/$defs/id"},
          "realm_revision": {"type": "integer", "minimum": 1},
          "descriptor_digest": {"$ref": "#/$defs/digest"},
          "audience": {"const": "shared"},
          "required_policies": {
            "type": "array", "minItems": 2, "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "ref": {"$ref": "#/$defs/id"},
                "revision": {"type": "integer", "minimum": 1},
                "visibility": {"const": "shared"},
                "audience_expression": {"const": "current:project-readers"}
              },
              "required": ["ref", "revision", "visibility", "audience_expression"],
              "additionalProperties": false
            }
          },
          "dependency_identities": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/identity"}},
          "dependency_versions": {
            "type": "array", "minItems": 1, "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "identity": {"$ref": "#/$defs/identity"},
                "revision": {"type": "integer", "minimum": 1},
                "metadata_digest": {"$ref": "#/$defs/digest"}
              },
              "required": ["identity", "revision", "metadata_digest"],
              "additionalProperties": false
            }
          }
        },
        "required": ["envelope_version", "identity", "realm_id", "realm_revision", "descriptor_digest", "audience", "required_policies", "dependency_identities", "dependency_versions"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "tenant_id", "project_id", "dataset_version", "snapshot_sha256", "policy_epoch", "envelopes"],
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1},
    "identity": {
      "type": "object",
      "properties": {
        "tenant_id": {"$ref": "#/$defs/id"},
        "project_id": {"$ref": "#/$defs/id"},
        "source_connection_id": {"$ref": "#/$defs/id"},
        "record_type": {"$ref": "#/$defs/id"},
        "record_id": {"$ref": "#/$defs/id"},
        "record_revision": {"$ref": "#/$defs/id"}
      },
      "required": ["tenant_id", "project_id", "source_connection_id", "record_type", "record_id", "record_revision"],
      "additionalProperties": false
    }
  }
}
