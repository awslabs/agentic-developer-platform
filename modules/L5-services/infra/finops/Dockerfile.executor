FROM mcr.microsoft.com/playwright/python:v1.56.0-noble

COPY wheel/*.whl /tmp/wheel/
RUN python -m pip install --no-cache-dir awslambdaric==3.1.1 playwright==1.56.0 /tmp/wheel/*.whl \
    && rm -rf /tmp/wheel

ENV PYTHONUNBUFFERED=1
USER pwuser
RUN python -c "import os, tempfile, awslambdaric; \
    from l5_services.adapters.finops.executor_host import lambda_handler; \
    from playwright.sync_api import sync_playwright; \
    assert os.geteuid() != 0 and callable(lambda_handler); \
    scratch = tempfile.TemporaryFile(dir='/tmp'); scratch.write(b'finops'); scratch.seek(0); assert scratch.read() == b'finops'; scratch.close(); \
    browser = sync_playwright().start(); assert os.access(browser.chromium.executable_path, os.R_OK | os.X_OK); browser.stop()"
ENTRYPOINT ["python", "-m", "awslambdaric"]
CMD ["l5_services.adapters.finops.executor_host.lambda_handler"]
