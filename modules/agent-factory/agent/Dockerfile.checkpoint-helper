FROM public.ecr.aws/docker/library/python:3.12-slim-trixie
RUN groupadd -g 10001 agent && useradd -u 10001 -g agent -M -s /bin/sh agent
WORKDIR /app
COPY agent/scripts/crew_checkpoint.py agent/scripts/crew_checkpoint_helper.py agent/scripts/crew_checkpoint_restore_entry.py ./
COPY agent/chat-checkpoint-helper agent/chat-checkpoint-restore ./
RUN chmod +x ./chat-checkpoint-helper ./chat-checkpoint-restore
USER agent:agent
ENTRYPOINT ["/app/chat-checkpoint-helper"]
