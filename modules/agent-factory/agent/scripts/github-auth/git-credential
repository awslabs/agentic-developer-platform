#!/usr/bin/env node
'use strict';
const fs = require('fs');
if (process.argv[2] !== 'get') process.exit(0);
if (process.env.ADP_TOKEN_MODE === 'mediated' || ['1','true','yes'].includes((process.env.ADP_MEDIATED_GITHUB_ENABLED || '').toLowerCase())) process.exit(1);
const fields = Object.fromEntries(fs.readFileSync(0, 'utf8').split('\n').filter(x => x.includes('=')).map(x => [x.slice(0,x.indexOf('=')), x.slice(x.indexOf('=')+1)]));
if (fields.protocol !== 'https' || fields.host !== 'github.com' || !process.env.REPO_OWNER || !process.env.REPO_NAME) process.exit(1);
const target = `${process.env.REPO_OWNER}/${process.env.REPO_NAME}`;
if ((fields.path || '').replace(/\.git$/, '') !== target) process.exit(1);
let token;
try {
  // Finalization uses the fresh action token, never a stopped worker's file.
  token = process.env.ADP_GITHUB_FINALIZATION === 'true' ? process.env.GH_TOKEN : fs.readFileSync(process.env.ADP_TOKEN_FILE, 'utf8').trim();
} catch { process.exit(1); }
if (!token || /[\r\n]/.test(token)) process.exit(1);
process.stdout.write(`username=x-access-token\npassword=${token}\n\n`);
