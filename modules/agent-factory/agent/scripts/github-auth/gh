#!/usr/bin/env node
'use strict';
const fs = require('fs');
const { spawnSync } = require('child_process');
const path = require('path');
function refuse() { process.stderr.write('GitHub runtime authentication unavailable or refused\n'); process.exit(1); }
if (process.env.ADP_TOKEN_MODE === 'mediated' || ['1','true','yes'].includes((process.env.ADP_MEDIATED_GITHUB_ENABLED || '').toLowerCase())) refuse();
const args = process.argv.slice(2);
if ((process.env.GH_HOST || 'github.com') !== 'github.com') refuse();
for (let i = 0; i < args.length; i++) {
  if (args[i] === '--hostname' && args[i + 1] !== 'github.com') refuse();
  if (args[i].startsWith('--hostname=') && args[i] !== '--hostname=github.com') refuse();
}
// gh api accepts an absolute endpoint. Never forward the installation token to
// another host. Values of body/header/field flags are not endpoints.
if (args[0] === 'api') {
  const withValue = new Set(['-H','--header','-f','--raw-field','-F','--field','--input','-X','--method','--hostname','--jq','-q','--template','-t','--cache']);
  for (let i = 1; i < args.length; i++) {
    if (withValue.has(args[i])) { i++; continue; }
    if (args[i].startsWith('-')) continue;
    if (/^https?:\/\//.test(args[i])) {
      try {
        const endpoint = new URL(args[i]);
        if (endpoint.protocol !== 'https:' || endpoint.hostname !== 'api.github.com' || endpoint.username || endpoint.password || endpoint.port) refuse();
      } catch { refuse(); }
    }
    break;
  }
}
let token, real;
try {
  token = fs.readFileSync(process.env.ADP_TOKEN_FILE, 'utf8').trim();
  real = fs.realpathSync(process.env.ADP_REAL_GH);
  if (!token || /[\r\n]/.test(token) || !path.isAbsolute(real) || real === fs.realpathSync(__filename)) refuse();
} catch { refuse(); }
const env = { ...process.env, GH_TOKEN: token, GITHUB_TOKEN: token, GH_APP_TOKEN: token };
delete env.GH_APP_PRIVATE_KEY; delete env.GH_APP_KEY;
const result = spawnSync(real, args, { env, stdio: 'inherit' });
process.exit(result.status === null ? 1 : result.status);
