{
  "name": "github-ccsdk-agent",
  "version": "1.0.0",
  "description": "Autonomous GitHub agent using Anthropic Agent SDK",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "probe:invocability": "node dist/invocability-probe/index.js",
    "generate:invocability-manifest": "ts-node src/invocability-probe/generate-manifest.ts",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@aws-sdk/client-bedrock-runtime": "^3.1145.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1145.0",
    "@aws-sdk/client-dynamodb": "^3.1145.0",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/client-secrets-manager": "^3.1145.0",
    "@aws-sdk/client-sqs": "^3.1145.0",
    "@aws-sdk/credential-provider-node": "^3.750.0",
    "@aws-sdk/credential-provider-web-identity": "3.972.78",
    "@aws-sdk/lib-dynamodb": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@smithy/hash-node": "^4.5.2",
    "@smithy/signature-v4": "^5.3.14",
    "jsonwebtoken": "^9.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^26.6.4",
    "esbuild": "0.28.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "handlebars": ">=4.7.9",
    "picomatch": ">=4.0.4",
    "brace-expansion@^1": ">=1.1.18 <2",
    "brace-expansion@^2": ">=2.1.4 <3",
    "fast-uri@^3": ">=3.1.6 <4",
    "ip-address@^10": ">=10.3.1 <11",
    "js-yaml@^3": ">=3.15.2 <4",
    "@modelcontextprotocol/sdk": ">=1.30.0 <2",
    "@hono/node-server": ">=2.0.10 <3",
    "@babel/core": ">=7.29.6 <8",
    "body-parser": ">=2.3.0 <3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
