# =============================================================================
# adp-agent-runtime-base — heavy toolchain image, rebuilt rarely
# =============================================================================
# Contains: Ubuntu 24.04, Python 3.12, Node 22, git, gh, aws-cli, kubectl,
# ripgrep/fd/fzf/jq, build-essential, and the Python deps the pod needs.
#
# Rebuilt on:
#   - Changes to this file (via codebuild/bs-agent-runtime-base.yml)
#   - A weekly cron (to pick up security patches and npm registry updates)
#
# The per-PR `adp-agent-runtime` image (Dockerfile) is a thin overlay that
# copies compiled agent code + entrypoint + personas on top of this base,
# turning a 3-4 min build into ~30s and isolating apt/npm flakiness to the
# weekly base rebuild.
# =============================================================================

FROM public.ecr.aws/docker/library/ubuntu:24.04

LABEL org.opencontainers.image.title="adp-agent-runtime-base"
LABEL org.opencontainers.image.description="Heavy toolchain base for the hosted agent runtime. See Dockerfile for the per-PR overlay."
LABEL org.opencontainers.image.source="https://github.com/aws-e/adp"

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# System packages: build tools, Python 3.12, git, utilities.
# Uses apt retry wrapper so a transient archive.ubuntu.com hiccup gives up
# only after 3 attempts, rather than failing the build instantly.
RUN set -eux; \
    for i in 1 2 3; do \
        apt-get update && break || { echo "apt-get update attempt $i failed; retrying in 10s"; sleep 10; }; \
    done; \
    for i in 1 2 3; do \
        apt-get install -y --no-install-recommends \
            build-essential \
            pkg-config \
            libssl-dev \
            libffi-dev \
            python3 \
            python3-pip \
            python3-venv \
            git \
            curl \
            wget \
            ca-certificates \
            gnupg \
            ripgrep \
            fd-find \
            fzf \
            jq \
            vim-tiny \
            unzip \
            sudo \
        && break || { echo "apt-get install attempt $i failed; retrying in 15s"; sleep 15; }; \
    done; \
    rm -rf /var/lib/apt/lists/*

# Install yq (YAML processor)
RUN curl -fsSL "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64" \
    -o /usr/local/bin/yq && chmod +x /usr/local/bin/yq

# Install Node.js 22 (also via NodeSource — same apt-retry approach)
RUN set -eux; \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash -; \
    for i in 1 2 3; do \
        apt-get install -y --no-install-recommends nodejs \
        && break || { echo "nodejs install attempt $i failed; retrying in 15s"; sleep 15; }; \
    done; \
    rm -rf /var/lib/apt/lists/*

# Install pnpm and yarn via corepack. The Node 22 image ships a yarn stub
# at /usr/bin/yarn, so `npm install -g yarn` fails with EEXIST. Corepack
# is the modern way to install both and handles replacement idempotently.
RUN corepack enable && \
    corepack prepare pnpm@latest --activate && \
    corepack prepare yarn@stable --activate

# Install GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    | tee /etc/apt/sources.list.d/github-cli.list > /dev/null && \
    apt-get update && apt-get install -y --no-install-recommends gh && \
    rm -rf /var/lib/apt/lists/*

# Install AWS CLI v2
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip && \
    unzip -q /tmp/awscliv2.zip -d /tmp && \
    /tmp/aws/install && \
    rm -rf /tmp/aws /tmp/awscliv2.zip

# Install kubectl
RUN curl -fsSL "https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" \
    -o /usr/local/bin/kubectl && chmod +x /usr/local/bin/kubectl

# Install pip-based Python tools (uv, poetry)
RUN pip3 install --no-cache-dir --break-system-packages uv poetry

# Python runtime deps for entrypoint.py + lib/
#   boto3        — Secrets Manager, STS, DynamoDB clients (vault_client, sts_assume)
#   PyJWT[crypto] — GitHub App installation-token JWT minting (github_token)
#   requests     — HTTPS calls to GitHub API (github_token)
RUN pip3 install --no-cache-dir --break-system-packages \
    'boto3>=1.34' \
    'PyJWT[crypto]>=2.9' \
    'requests>=2.31'

# Create non-root user (overlay image inherits — no need to recreate).
RUN groupadd -g 1001 agent && \
    useradd -m -u 1001 -g agent -s /bin/bash agent && \
    mkdir -p /app /work && \
    chown -R agent:agent /app /work

# Configure git credential helper for GitHub token auth
RUN git config --system credential.helper 'store' && \
    git config --system --add safe.directory '*'

# Defaults. The per-PR overlay sets USER, WORKDIR, ENTRYPOINT.
ENV NODE_ENV=production
ENV HOME=/home/agent
ENV PATH="/app/node_modules/.bin:${PATH}"
