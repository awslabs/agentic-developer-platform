#!/bin/sh
# gh CLI wrapper — installed at /usr/local/bin/gh, shadowing /usr/bin/gh.
#
# (issue #1469) Reads a fresh GitHub App token from the token file so
# long-running agents don't 401 after the 1h expiry.
#
# That is the wrapper's ONLY job. The caller's arguments and comment body are
# passed to the real `gh` byte-for-byte.
#
# Issue #5120 (recurrence of #2149): this wrapper used to inspect cross-issue
# `gh issue/pr comment` calls, grep the body for the first `@agent-<persona>`
# token, seed a dispatch pointer for the target channel, and rewrite the body to
# carry an `adp-dispatch:<persona>` marker. The webhook's bot-sender gate accepts
# that marker as a deliberate dispatch, so ordinary prose that merely NAMED a
# persona — a status update, a review header, a quoted example — started a real
# agent run the author never requested. Minting dispatch authority is now
# exclusively the job of `adp-trigger`, which POSTs to /agent/trigger and has its
# lineage verified server-side. An ordinary comment stays prose.
#
# Do not reintroduce body rewriting here. A wrapper that infers intent from prose
# cannot tell "please run the developer" from "the developer already ran".

TOKEN_FILE="${ADP_TOKEN_FILE:-/tmp/.adp-gh-token}"
if [ -f "$TOKEN_FILE" ]; then
  GH_TOKEN="$(cat "$TOKEN_FILE")"
  export GH_TOKEN
fi

# ADP_REAL_GH exists so the wrapper is testable without the image layout; in the
# image the real binary is moved to /usr/bin/gh by the Dockerfile.
exec "${ADP_REAL_GH:-/usr/bin/gh}" "$@"
