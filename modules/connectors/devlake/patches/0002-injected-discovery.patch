-			Name:     fmt.Sprintf("%v", o.Login),
-			FullName: fmt.Sprintf("%v", o.Login),
-		})
@@ -80,0 +117,29 @@ func listGithubUserOrgs(
+	organizations, nextPage, err := listGithubOrgs(apiClient, page)
+	return append(children, organizations...), nextPage, err
+}
+
+func listGithubUser(apiClient plugin.ApiClient) ([]dsmodels.DsRemoteApiScopeListEntry[models.GithubRepo], errors.Error) {
+	userBody, err := apiClient.Get("user", nil, nil)
+	if err != nil {
+		return nil, err
+	}
+	var user org
+	if err := api.UnmarshalResponse(userBody, &user); err != nil {
+		return nil, err
+	}
+	return []dsmodels.DsRemoteApiScopeListEntry[models.GithubRepo]{{
+		Type:     api.RAS_ENTRY_TYPE_GROUP,
+		Id:       fmt.Sprintf("%v", user.Login),
+		Name:     fmt.Sprintf("%v", user.Login),
+		FullName: fmt.Sprintf("%v", user.Login),
+	}}, nil
+}
+
