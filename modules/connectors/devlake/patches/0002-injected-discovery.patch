diff --git a/backend/plugins/github/api/remote_api.go b/backend/plugins/github/api/remote_api.go
index 9bae777..b102f16 100644
--- a/backend/plugins/github/api/remote_api.go
+++ b/backend/plugins/github/api/remote_api.go
@@ -57,0 +58,44 @@ func listGithubRemoteScopes(
+func ADPListRemoteScopes(
+	apiClient plugin.ApiClient,
+	installation bool,
+	namespace string,
+	page GithubRemotePagination,
+) ([]dsmodels.DsRemoteApiScopeListEntry[models.GithubRepo], *GithubRemotePagination, errors.Error) {
+	if page.Page == 0 {
+		page.Page = 1
+	}
+	if page.PerPage == 0 {
+		page.PerPage = 100
+	}
+	if !installation && namespace == "" {
+		if page.Page == 1 {
+			children, err := listGithubUser(apiClient)
+			if err != nil {
+				return nil, nil, err
+			}
+			return children, &GithubRemotePagination{Page: 2, PerPage: page.PerPage}, nil
+		}
+		page.Page--
+		children, nextPage, err := listGithubOrgs(apiClient, page)
+		if nextPage != nil {
+			nextPage.Page++
+		}
+		return children, nextPage, err
+	}
+	connection := &models.GithubConnection{}
+	if installation {
+		connection.AuthMethod = plugin.AUTH_METHOD_APPKEY
+	}
+	children, nextPage, err := listGithubRemoteScopes(connection, apiClient, namespace, page)
+	if err != nil || !installation || namespace == "" {
+		return children, nextPage, err
+	}
+	selected := children[:0]
+	for _, child := range children {
+		if child.ParentId != nil && *child.ParentId == namespace {
+			selected = append(selected, child)
+		}
+	}
+	return selected, nextPage, nil
+}
+
