      "width": 8,
      "height": 6,
      "properties": {
        "title": "X-Ray Trace Count",
        "metrics": [
          [ "AWS/X-Ray", "ApproximateTraceCount", "GroupName", "Default", { "stat": "Sum", "label": "Traces" } ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "period": 60
      }
    },
    {
      "type": "log",
      "x": 8,
      "y": 29,
      "width": 16,
      "height": 6,
      "properties": {
        "title": "Slowest Requests (last 1h)",
        "query": "SOURCE '/aws/containerinsights/bedrockgw-dev-eks-cluster/application' | fields @timestamp, @message\n| parse @message '\"latency_ms\": *,' as latency_ms\n| parse @message '\"event\": \"*\"' as event\n| parse @message '\"path\": \"*\"' as path\n| parse @message '\"status_code\": *,' as status\n| filter event = 'request_end' and path like '/model/'\n| sort latency_ms desc\n| limit 10\n| fields @timestamp, latency_ms, status, path",
        "region": "us-east-1",
        "stacked": false,
        "view": "table"
      }
    },
