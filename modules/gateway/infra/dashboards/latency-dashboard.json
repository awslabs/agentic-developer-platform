    },
    {
      "type": "text",
      "x": 0,
      "y": 15,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## 🏗️ Gateway Pod (Application-Level Latency from Logs)"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 16,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Bedrock Latency by Model (p50 / p90 / max)",
        "query": "SOURCE '/aws/containerinsights/bedrockgw-dev-eks-cluster/application' | fields @timestamp, @message\n| parse @message '\"path\": \"*\"' as path\n| parse @message '\"latency_ms\": *,' as latency_ms\n| parse @message '\"event\": \"*\"' as event\n| filter event = 'request_end' and path like '/model/'\n| parse path '/model/*/invoke' as model_path\n| fields replace(model_path, 'global.anthropic.', '') as model\n| fields replace(model, 'us.anthropic.', '') as model\n| stats avg(latency_ms) as avg_ms, pct(latency_ms, 50) as p50_ms, pct(latency_ms, 90) as p90_ms, max(latency_ms) as max_ms, count() as requests by model\n| sort avg_ms desc",
        "region": "us-east-1",
        "stacked": false,
        "view": "table"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 16,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Request Latency Over Time (from app logs)",
        "query": "SOURCE '/aws/containerinsights/bedrockgw-dev-eks-cluster/application' | fields @timestamp, @message\n| parse @message '\"latency_ms\": *,' as latency_ms\n| parse @message '\"event\": \"*\"' as event\n| parse @message '\"path\": \"*\"' as path\n| filter event = 'request_end' and path like '/model/'\n| stats avg(latency_ms) as avg_ms, pct(latency_ms, 50) as p50_ms, pct(latency_ms, 95) as p95_ms by bin(5m)",
        "region": "us-east-1",
        "stacked": false,
        "view": "timeSeries"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 22,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Gateway Component Breakdown (from timings)",
        "query": "SOURCE '/aws/containerinsights/bedrockgw-dev-eks-cluster/application' | fields @timestamp, @message\n| parse @message '\"event\": \"*\"' as event\n| parse @message '\"path\": \"*\"' as path\n| parse @message '\"timings\": {*}' as timings_raw\n| filter event = 'request_end' and path like '/model/'\n| parse timings_raw '\"auth\": *,' as auth_ms\n| parse timings_raw '\"budget_check\": *,' as budget_ms\n| parse timings_raw '\"ratelimit_check\": *,' as ratelimit_ms\n| parse timings_raw '\"bedrock\": *,' as bedrock_ms\n| parse timings_raw '\"total\": *}' as total_ms\n| stats avg(auth_ms) as avg_auth, avg(budget_ms) as avg_budget, avg(ratelimit_ms) as avg_ratelimit, avg(bedrock_ms) as avg_bedrock, avg(total_ms) as avg_total, count() as requests by bin(5m)",
        "region": "us-east-1",
        "stacked": false,
        "view": "timeSeries"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 22,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Streaming vs Non-Streaming Latency",
        "query": "SOURCE '/aws/containerinsights/bedrockgw-dev-eks-cluster/application' | fields @timestamp, @message\n| parse @message '\"latency_ms\": *,' as latency_ms\n| parse @message '\"event\": \"*\"' as event\n| parse @message '\"path\": \"*\"' as path\n| filter event = 'request_end' and path like '/model/'\n| fields case(path like 'invoke-with-response-stream', 'streaming', 1, 'non-streaming') as req_type\n| stats avg(latency_ms) as avg_ms, pct(latency_ms, 50) as p50_ms, pct(latency_ms, 95) as p95_ms, count() as requests by req_type, bin(5m)",
        "region": "us-east-1",
        "stacked": false,
        "view": "timeSeries"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 28,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "## 📊 X-Ray Traces"
      }
    },
    {
      "type": "metric",
