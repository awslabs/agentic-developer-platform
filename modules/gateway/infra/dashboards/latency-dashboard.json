      "y": 9,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "ALB HTTP Status Codes",
        "metrics": [
          [ "AWS/ApplicationELB", "HTTPCode_Target_2XX_Count", "LoadBalancer", "app/k8s-bedrockg-bedrockg-96a0136fc5/a04d4e1ab78a9b6c", { "stat": "Sum", "label": "2xx", "color": "#2ca02c" } ],
          [ "AWS/ApplicationELB", "HTTPCode_Target_4XX_Count", "LoadBalancer", "app/k8s-bedrockg-bedrockg-96a0136fc5/a04d4e1ab78a9b6c", { "stat": "Sum", "label": "4xx", "color": "#ff7f0e" } ],
          [ "AWS/ApplicationELB", "HTTPCode_Target_5XX_Count", "LoadBalancer", "app/k8s-bedrockg-bedrockg-96a0136fc5/a04d4e1ab78a9b6c", { "stat": "Sum", "label": "5xx", "color": "#d62728" } ],
          [ "AWS/ApplicationELB", "HTTPCode_ELB_5XX_Count", "LoadBalancer", "app/k8s-bedrockg-bedrockg-96a0136fc5/a04d4e1ab78a9b6c", { "stat": "Sum", "label": "ALB 5xx", "color": "#9467bd" } ]
