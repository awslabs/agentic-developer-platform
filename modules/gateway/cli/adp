    adp deployment add integration --url https://<integration-host>
    # then, in each terminal:
    export ADP_DEPLOYMENT=dev      # or integration
    adp login && adp codex         # sessions stay independent

Why the two launchers differ:
    Codex has no hook for refreshing a credential, so it needs the local proxy
    running and a placeholder in ADP_GATEWAY_DUMMY — 'adp codex' does both for
    you. Claude Code calls 'adp token' itself on every request, so bare 'claude'
    already works; 'adp claude' just fails fast with a login hint instead of
    erroring mid-session. Args after either verb go straight to the tool.
EOF
}

# Refuse `--deployment` AFTER the verb, for the verbs that own their own flags.
#
# The flag is global and parsed before the verb, so a later one used to be passed
# down and ignored: `adp token --deployment prod` printed the DEFAULT deployment's
# access token and exited 0, and `adp status --deployment prod` reported the
# default while naming prod on the command line. A user cannot tell either from
# success, which makes it the same silent-substitution failure an unknown name is
# already refused for. `codex` and `claude` are exempt: every token after those
# verbs belongs to the tool, and stealing one would break a legitimate tool flag.
reject_post_verb_deployment() {
    local argument
    for argument in "$@"; do
        case "${argument}" in
            --deployment|--deployment=*)
                print_error "--deployment selects the deployment for the whole command, so it goes BEFORE the verb."
                print_warning "Use: adp --deployment <name> ${ADP_CURRENT_VERB:-<command>}"
                exit 1
                ;;
            --) return 0 ;;
        esac
    done
}

main() {
    check_dependencies

    # `--deployment NAME` is a GLOBAL option and must appear BEFORE the verb.
    # It is parsed here, not per-verb, because `codex` and `claude` pass every
    # token they do not own straight through to the tool — accepting it after the
    # verb would mean stealing a flag that might belong to Codex or Claude Code.
    local requested_deployment=""
    while [ $# -gt 0 ]; do
        case "${1:-}" in
            --deployment)
                if [ -n "${requested_deployment}" ]; then
                    print_error "Supply --deployment only once, before the command."
                    exit 1
                fi
                if [ -z "${2:-}" ]; then
                    print_error "--deployment needs a name: adp --deployment dev status"
                    exit 1
                fi
                requested_deployment="$2"
                shift 2
                ;;
            --deployment=*)
                if [ -n "${requested_deployment}" ]; then
                    print_error "Supply --deployment only once, before the command."
                    exit 1
                fi
                requested_deployment="${1#--deployment=}"
                if [ -z "${requested_deployment}" ]; then
                    print_error "--deployment needs a name: adp --deployment dev status"
                    exit 1
                fi
                shift
                ;;
            *) break ;;
        esac
    done

    local command="${1:-}"
    shift || true

    # Resolve before dispatch, so every verb below — and every child process —
    # sees one pinned deployment.
    #
    # Three verbs are exempt, all for the same reason: they are what a user runs
    # when the selection is BROKEN. `deployment` is how you fix a bad selection,
    # and `help`/`version` must never be the commands that refuse to run because
    # ADP_DEPLOYMENT has a typo in it.
    case "${command}" in
        deployment)
            if [ -n "${requested_deployment}" ]; then
                print_error "'adp deployment' manages deployments; it takes no --deployment selection."
                exit 1
            fi
            ;;
        help|--help|-h|version|--version|-v|"") ;;
        *) resolve_deployment "${requested_deployment}" ;;
    esac

    # Every verb below EXCEPT the tool launchers owns its own flag surface, so
    # a `--deployment` among its arguments is a misplaced global option rather than
    # the tool's own flag, and is refused instead of silently ignored.
    case "${command}" in
        codex|claude|kimi|help|--help|-h|version|--version|-v|"") ;;
        *) ADP_CURRENT_VERB="${command}" reject_post_verb_deployment "$@" ;;
    esac

    case "${command}" in
        deployment) cmd_deployment "$@" ;;
        aws)     exec_python_helper "adp-aws.py" "$@" ;;
        bedrock) exec_python_helper "adp-bedrock.py" "$@" ;;
        admin)   exec_python_helper "adp-admin.py" "$@" ;;
        github)  exec_python_helper "adp-github.py" "$@" ;;
        # Superplane workloads (Issue #5039). Goes through the same helper path
        # as the areas above, so it inherits ONE credential path: the session
        # `adp login` already established. The extension has no token store of
        # its own — that is the whole point of the verb existing here rather
        # than as a separate `superplane` CLI on the user's PATH.
        superplane) exec_python_helper "adp-superplane.py" "$@" ;;
        models) exec_python_helper "adp-models.py" "$@" ;;
        # AI-DLC delivery flows (Issue #5331). Same helper path as the areas
        # above, so it inherits the one credential path: the session `adp login`
        # already established. This dispatcher is also the foundation the later
        # amendment subcommands (#5329) attach to.
        flow)    exec_python_helper "adp-flow.py" "$@" ;;
        login)   cmd_login "$@" ;;
        status)  cmd_status "$@" ;;
        # Pure pass-throughs. The core owns their flags and their exit codes.
        logout|token|refresh|serve)
                 core "${command}" "$@" ;;
        # `import` establishes a session, like `login`, so it gets login's
        # URL-vs-selection check rather than going straight through.
        import)  cmd_import "$@" ;;
        # `setup` is our own subcommand; anything else — including nothing at all
        # — is a LAUNCH with passthrough args. Codex and Claude both have rich
        # flag surfaces we must not shadow, so the tool owns every token we do
        # not claim, and `--` before an arg that collides with `setup` is the
        # escape hatch (`adp codex -- setup`).
        codex)
            case "${1:-}" in
                setup) shift; cmd_codex_setup "$@" ;;
                --)    shift; cmd_codex_launch "$@" ;;
                *)     cmd_codex_launch "$@" ;;
            esac
            ;;
        kimi)
            if [ "${1:-}" = "--" ]; then shift; fi
            cmd_kimi_launch "$@"
            ;;
        claude)
            case "${1:-}" in
                setup) shift; cmd_claude_setup "$@" ;;
                --)    shift; cmd_claude_launch "$@" ;;
                *)     cmd_claude_launch "$@" ;;
            esac
            ;;
        daemon)
            case "${1:-}" in
                install)   shift; cmd_daemon_install "$@" ;;
                uninstall) shift; cmd_daemon_uninstall "$@" ;;
                "")        print_error "Missing subcommand: 'adp daemon install' or 'adp daemon uninstall'."; exit 1 ;;
                *)         print_error "Unknown 'adp daemon' subcommand: $1"; exit 1 ;;
            esac
            ;;
        update)  cmd_update "$@" ;;
        version|--version|-v) echo "adp ${ADP_VERSION}" ;;
        help|--help|-h) usage ;;
        "")
            usage
            exit 1
            ;;
        *)
            print_error "Unknown command: ${command}"
            usage
            exit 1
            ;;
    esac
}

main "$@"
