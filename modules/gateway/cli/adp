    product list|create|show|update|budget show|budget set
    product sources|source-bind|source-bindings|source-verify|source-session|source-discover|source-operation|source-apply
    product lifecycle    Archive or restore with --action and --revision
                          Hosted chat readiness and owned retained history
    tenant list           List visible ADP tenant memberships
    tenant current        Show canonical tenant and selection source
    tenant use TENANT_ID   Save a deployment/login-specific default (--dry-run supported)
    --tenant TENANT_ID     Pin a tenant for this command; ADP_TENANT selects per terminal

    task submit           Submit a Task request file with a durable --key
    task status           Read Task state, result and artifact references
    task monitor          Follow bounded progress with a saved resume cursor
    task abort            Request durable cancellation (requires --yes)

    admin login           Sign in with a Cognito administrator account
    admin setup           Check and resume first-time setup
    admin bedrock         Connect AWS destinations and manage model routing
    admin github          Configure this deployment's GitHub App and check it
    admin github status --maintenance
    admin github rotate-key|disconnect
                          Review App/key revision with --dry-run before --yes
    admin github org-binding list|add|remove --org ID
                          Manage installation routing for an organization
    bedrock status        Show your effective Bedrock destination
    bedrock select|reset  Review and change only your own permitted route
    admin bedrock mappings list|show|set|delete --scope SCOPE --target ID
    admin bedrock connection-link add|remove --destination ID --connection ID
    update [--to <version>]
                          Re-pull this CLI from your gateway; --to pins the exact
                          version and installs nothing if it is not what is served
    update --rollback [--to <version>]
                          Restore the previous version (--to verifies which)
    version               Print the version
    help                  Show this message

Day 1, start to finish:
    curl -fsSL https://<gateway>/api/cli/install.sh | sh -s -- --gateway-url https://<gateway>
    adp login
    adp status
    adp codex setup        # or: adp claude setup
    adp codex              # or: claude

Three deployments, three terminals, one machine:
    adp deployment add dev         --url https://<dev-host>
    adp deployment add integration --url https://<integration-host>
    # then, in each terminal:
    export ADP_DEPLOYMENT=dev      # or integration
    adp login && adp codex         # sessions stay independent

Why the launchers differ:
    Codex and Hermes have no hook for refreshing a credential, so they need the
    local proxy running and a placeholder in ADP_GATEWAY_DUMMY — 'adp codex' /
    'adp hermes' do both for you, and share one already-running proxy rather
    than starting a second. Claude Code calls 'adp token' itself on every
    request, so bare 'claude' already works; 'adp claude' just fails fast with a
    login hint instead of erroring mid-session. Args after a verb go straight to
    the tool.
EOF
}

# Refuse `--deployment` AFTER the verb, for the verbs that own their own flags.
#
# The flag is global and parsed before the verb, so a later one used to be passed
# down and ignored: `adp token --deployment prod` printed the DEFAULT deployment's
# access token and exited 0, and `adp status --deployment prod` reported the
# default while naming prod on the command line. A user cannot tell either from
# success, which makes it the same silent-substitution failure an unknown name is
# already refused for. `codex` and `claude` are exempt: every token after those
# verbs belongs to the tool, and stealing one would break a legitimate tool flag.
reject_post_verb_deployment() {
    local argument
    for argument in "$@"; do
        case "${argument}" in
            --tenant|--tenant=*)
                if [ "${ADP_CURRENT_VERB:-}" = "access" ]; then continue; fi
                if [ "${ADP_CURRENT_VERB:-}" = "admin" ] && [ "${1:-}" = "tenant" ] && [ "${2:-}" = "org-links" ]; then
                    continue
                fi
                print_error "--tenant must appear before the command."
                exit 1
                ;;
            --deployment|--deployment=*)
                print_error "--deployment selects the deployment for the whole command, so it goes BEFORE the verb."
                print_warning "Use: adp --deployment <name> ${ADP_CURRENT_VERB:-<command>}"
                exit 1
                ;;
            --) return 0 ;;
        esac
    done
}

main() {
    check_dependencies

    # `--deployment NAME` is a GLOBAL option and must appear BEFORE the verb.
    # It is parsed here, not per-verb, because `codex` and `claude` pass every
    # token they do not own straight through to the tool — accepting it after the
    # verb would mean stealing a flag that might belong to Codex or Claude Code.
    local requested_deployment=""
    local requested_tenant=""
    while [ $# -gt 0 ]; do
        case "${1:-}" in
            --tenant)
                if [ -n "${requested_tenant}" ] || [ -z "${2:-}" ]; then
                    print_error "Supply --tenant once with an ID before the command."
                    exit 1
                fi
                requested_tenant="$2"
                shift 2
                ;;
            --tenant=*)
                if [ -n "${requested_tenant}" ] || [ -z "${1#--tenant=}" ]; then
                    print_error "Supply --tenant once with an ID before the command."
                    exit 1
                fi
                requested_tenant="${1#--tenant=}"
                shift
                ;;
            --deployment)
                if [ -n "${requested_deployment}" ]; then
                    print_error "Supply --deployment only once, before the command."
                    exit 1
                fi
                if [ -z "${2:-}" ]; then
                    print_error "--deployment needs a name: adp --deployment dev status"
                    exit 1
                fi
                requested_deployment="$2"
                shift 2
                ;;
            --deployment=*)
                if [ -n "${requested_deployment}" ]; then
                    print_error "Supply --deployment only once, before the command."
                    exit 1
                fi
                requested_deployment="${1#--deployment=}"
                if [ -z "${requested_deployment}" ]; then
                    print_error "--deployment needs a name: adp --deployment dev status"
                    exit 1
                fi
                shift
                ;;
            *) break ;;
        esac
    done

    local command="${1:-}"
    shift || true

    if { [ "${command}" = "codex" ] || [ "${command}" = "claude" ]; } &&
       [ "$#" -eq 2 ] && [ "$1" = "setup" ] && [ "$2" = "--skills-only" ]; then
        if [ "${command}" = "codex" ]; then
            cmd_skills_sync --client codex
        else
            cmd_skills_sync --client claude-code
        fi
        return
    fi

    if [ "${ADP_CREW_TOOLS_URL+x}" ]; then
        require_identity || return $?
        if [ -n "${requested_deployment}${requested_tenant}" ]; then
            print_error "Crew host-run binding cannot use a laptop deployment or tenant selector."
            return 2
        fi
        # #9640: the box acts with the owner's session, so every product/flow/github command is the
        # laptop's; only human login, full client setup and MCP registration stay laptop-only.
        case "${command}:${1:-}" in
            login:*)
                print_error "Human login is unavailable on a Dev Box. Sign in with the laptop adp CLI or ADP dashboard; no token is stored here."
                return 2 ;;
            codex:setup|claude:setup)
                print_error "A Dev Box only supports 'adp ${command} setup --skills-only'; full setup requires a laptop."
                return 2 ;;
            mcp:configure)
                print_error "MCP registration is not available on a Dev Box; the Crew home is configured by the host."
                return 2 ;;
        esac
        case "${command}" in
            product) exec_python_helper "adp-product.py" "$@"; return $? ;;
            flow) exec_python_helper "adp-flow.py" "$@"; return $? ;;
            github) exec_python_helper "adp-github.py" "$@"; return $? ;;
            # A box has no deployment registry and host run never selects one, so
            # the general path's resolve_deployment() only printed "No ADP
            # deployment is configured" to stderr ahead of the real answer.
            status) cmd_status "$@"; return $? ;;
        esac
    fi

    if [ "${command}" = "mcp" ] && [ "$#" -eq 0 ] && {
        { [ -n "${SIGV4_PROXY_TARGET:-}" ] && [ -n "${SIGV4_PROXY_PORT:-}" ]; } || [ -n "${ADP_CREW_TOOLS_URL:-}" ];
    }; then
        if [ -n "${requested_deployment}${requested_tenant}" ]; then
            print_error "Proxy-mode MCP uses its workload binding; laptop deployment and tenant selectors are not supported."
            return 1
        fi
        exec_python_helper "adp-mcp.py"
        return
    fi

    local validate_knowledge=false
    case "${command}:${1:-}" in
        knowledge:show|knowledge:delete|knowledge:status|knowledge:watch|knowledge:reindex)
            validate_knowledge=true ;;
        admin:indexing)
            if [ "${2:-}" = "show" ]; then validate_knowledge=true; fi ;;
    esac
    if [ "${validate_knowledge}" = true ] && [ -f "$(adp_dir)/adp-knowledge.py" ] && command -v python3 >/dev/null 2>&1; then
        python3 "$(adp_dir)/adp-knowledge.py" --validate-target "${command}" "$@" || return $?
    fi

    # Resolve before dispatch, so every verb below — and every child process —
    # sees one pinned deployment.
    #
    # Three verbs are exempt, all for the same reason: they are what a user runs
    # when the selection is BROKEN. `deployment` is how you fix a bad selection,
    # and `help`/`version` must never be the commands that refuse to run because
    # ADP_DEPLOYMENT has a typo in it.
    case "${command}" in
        deployment)
            if [ -n "${requested_deployment}" ]; then
                print_error "'adp deployment' manages deployments; it takes no --deployment selection."
                exit 1
            fi
            ;;
        platform)
            if [ "${1:-}" = "status" ]; then
                resolve_deployment "${requested_deployment}"
            elif [ -n "${requested_deployment}" ]; then
                print_error "Platform lifecycle uses --profile and --confirm-account; --deployment selects only platform status."
                exit 1
            fi
            ;;
        help|--help|-h|version|--version|-v|"") ;;
        *) resolve_deployment "${requested_deployment}" "${command}" ;;
    esac

    # Tenant selection is separate from deployment and never changes Cognito's
    # global workspace. Repair/local commands remain usable without a tenant.
    local local_tool_setup=false
    case "${command}:${1:-}" in
        credential:use|credential:delivery-status|credential:host-setup|credential:host-register|credential:host-serve)
            # Private delivery authenticates its native session directly. A
            # generic tenant/proxy namespace cannot replace canonical authority.
            if [ -n "${requested_tenant}${ADP_TENANT:-}${ADP_TENANT_ID:-}" ]; then
                print_error "Native credential delivery uses the signed login's current tenant; tenant selectors are unsupported."
                return 1
            fi
            local_tool_setup=true
            ;;
        codex:setup|claude:setup|claude-desktop:setup|hermes:setup|tools:logout|tools:status|mcp:configure|mcp:operations)
            # Offline configuration needs no membership lookup. An explicit
            # selector still requests the selected tenant's proxy namespace.
            if [ -z "${requested_tenant}${ADP_TENANT:-}${ADP_TENANT_ID:-}" ]; then
                local_tool_setup=true
            fi
            ;;
    esac
    if [ "${command}" = "task" ]; then
        local task_human=false
        local task_arg
        for task_arg in "$@"; do
            if [ "${task_arg}" = "--human-login" ]; then task_human=true; fi
        done
        if [ "${task_human}" = false ]; then
            local_tool_setup=true
            if [ -n "${requested_tenant}" ]; then
                print_error "Task --tenant requires --human-login."
                exit 1
            fi
        fi
    fi
    if [ "${command}" = "flow" ] && [ "${1:-}" = "amendment" ] && [ "$#" -le 3 ]; then
        case "${!#}" in
            --help|-h) local_tool_setup=true ;;
        esac
    fi
    case "${command}" in
        deployment|help|--help|-h|version|--version|-v|login|logout|import|refresh|update|status|tenant|access|platform|daemon|"")
            if [ -n "${requested_tenant}" ] && [ "${command}" != "tenant" ]; then
                print_error "This command does not accept --tenant."
                exit 1
            fi
            ;;
        *)
            if [ "${local_tool_setup}" = false ] && [ "${1:-}" != "--help" ] && [ "${1:-}" != "-h" ] && ! { [ "${command}" = "admin" ] && [ "${1:-}" = "login" ]; }; then
                local tenant_exports
                # Issue #6437: this stdout is captured so it can be eval'd, which
                # also meant a FAILED resolution had its only diagnosis thrown
                # away — the caller saw a bare non-zero exit and EMPTY stdout. A
                # --json consumer then could not tell a tenant/login/gateway
                # failure from the verb's own refusal, and reported it as
                # whichever check happened to run next. Ask the helper for the
                # same output format the caller asked for, and replay what it
                # said instead of discarding it.
                local tenant_status=0
                local tenant_format=""
                local tenant_argument
                for tenant_argument in "$@"; do
                    if [ "${tenant_argument}" = "--json" ]; then tenant_format="--json"; fi
                done
                if [ -f "$(adp_dir)/adp-tenant.py" ]; then
                    tenant_exports="$(python3 "$(adp_dir)/adp-tenant.py" --resolve-env "${requested_tenant}" ${tenant_format})" || tenant_status=$?
                    if [ "${tenant_status}" -ne 0 ]; then
                        if [ -n "${tenant_exports}" ]; then
                            if [ "${command}" = "mcp" ]; then
                                printf '%s\n' "${tenant_exports}" >&2
                            else
                                printf '%s\n' "${tenant_exports}"
                            fi
                        fi
                        return "${tenant_status}"
                    fi
                    eval "${tenant_exports}"
                    resolve_deployment "${requested_deployment}"
                elif [ -n "${requested_tenant}${ADP_TENANT:-}" ]; then
                    print_error "Tenant helper missing. Run adp update."
                    exit 1
                fi
            fi
            ;;
    esac

    # Every verb below EXCEPT the tool launchers owns its own flag surface, so
    # a `--deployment` among its arguments is a misplaced global option rather than
    # the tool's own flag, and is refused instead of silently ignored.
    case "${command}" in
        codex|claude|hermes|kimi|help|--help|-h|version|--version|-v|"") ;;
        *) ADP_CURRENT_VERB="${command}" reject_post_verb_deployment "$@" ;;
    esac

    case "${command}" in
        deployment) cmd_deployment "$@" ;;
        tenant)
            if [ -n "${requested_tenant}" ]; then export ADP_TENANT_FLAG="${requested_tenant}"; fi
            exec_python_helper "adp-tenant.py" "$@"
            ;;
        aws)     exec_python_helper "adp-aws.py" "$@" ;;
        bedrock) exec_python_helper "adp-bedrock.py" "$@" ;;
        admin)   exec_python_helper "adp-admin.py" "$@" ;;
        gitlab) exec_python_helper "adp-gitlab.py" gitlab "$@" ;;
        github)  exec_python_helper "adp-github.py" "$@" ;;
        # Superplane workloads (Issue #5039). Goes through the same helper path
        # as the areas above, so it inherits ONE credential path: the session
        # `adp login` already established. The extension has no token store of
        # its own — that is the whole point of the verb existing here rather
        # than as a separate `superplane` CLI on the user's PATH.
        superplane) exec_python_helper "adp-superplane.py" "$@" ;;
        models) exec_python_helper "adp-models.py" "$@" ;;
        platform) exec_python_helper "adp-platform.py" "$@" ;;
        # AI-DLC delivery flows (Issue #5331). Same helper path as the areas
        # above, so it inherits the one credential path: the session `adp login`
        # already established. This dispatcher is also the foundation the later
        # amendment subcommands (#5329) attach to.
        access) exec_python_helper "adp-access.py" access "$@" ;;
        ratelimit) exec_python_helper "adp-ratelimit.py" ratelimit "$@" ;;
        budget)  exec_python_helper "adp-budget.py" budget "$@" ;;
        credential)
            case "${1:-}" in
                host-register|host-serve)
                    exec python3 -I "$(adp_dir)/adp-native-credential-host.py" "$@" ;;
                use|delivery-status|host-setup)
                    exec python3 -I "$(adp_dir)/adp-native-credentials.py" "$@" ;;
                *) exec_python_helper "adp-vault.py" credential "$@" ;;
            esac ;;
        identity) exec_python_helper "adp-vault.py" identity "$@" ;;
        usage)   exec_python_helper "adp-usage.py" usage "$@" ;;
        logs)    exec_python_helper "adp-usage.py" logs "$@" ;;
        agent)   exec_python_helper "adp-agent.py" "$@" ;;
        knowledge) exec_python_helper "adp-knowledge.py" knowledge "$@" ;;
        product) exec_python_helper "adp-product.py" "$@" ;;
        onboard) exec_python_helper "adp-onboard.py" "$@" ;;
        insights) exec_python_helper "adp-insights.py" "$@" ;;
        service) exec_python_helper "adp-service.py" "$@" ;;
        chat)    exec_python_helper "adp-chat.py" "$@" ;;
        devbox)  exec_python_helper "adp-devbox.py" "$@" ;;
        task)    exec_python_helper "adp-task.py" "$@" ;;
        flow)    exec_python_helper "adp-flow.py" "$@" ;;
        # Capability discovery and diagnosis (Issue #5621). Both verbs are reads
        # and share one helper because they answer the same question from the two
        # ends: `capabilities` asks what this deployment offers you before you
        # try, `doctor` explains what happened after a call failed. They reach
        # the server, so they go through the same helper path as the areas above
        # and inherit the session `adp login` established.
        capabilities|doctor)
                 exec_python_helper "adp-doctor.py" "${command}" "$@" ;;
        login)   cmd_login "$@" ;;
        status)  cmd_status "$@" ;;
        tools)   case "${1:-}" in
                     logout) shift; cmd_tools_logout "$@" ;;
                     status) shift; if [ "${1:-}" = "--access" ]; then
                                 shift; exec_python_helper "adp-doctor.py" "doctor" "--checks" "tools-access" "$@"
                             else
                                 cmd_status "$@"
                             fi ;;
                     *) print_error "Usage: adp tools status [--access [--json]]|logout"; return 1 ;;
                 esac ;;
        mcp)     if [ "${1:-}" = "configure" ]; then
                     shift; cmd_mcp_configure "$@"
                 else
                     exec python3 "$(adp_dir)/adp-mcp.py" "$@"
                 fi ;;
        # Pure pass-throughs. The core owns their flags and their exit codes.
        logout) clear_gitlab_session; core logout "$@" ;;
        token|refresh|serve)
                 core "${command}" "$@" ;;
        # `import` establishes a session, like `login`, so it gets login's
        # URL-vs-selection check rather than going straight through.
        import)  cmd_import "$@" ;;
        # `setup` is our own subcommand; anything else — including nothing at all
        # — is a LAUNCH with passthrough args. Codex and Claude both have rich
        # flag surfaces we must not shadow, so the tool owns every token we do
        # not claim, and `--` before an arg that collides with `setup` is the
        # escape hatch (`adp codex -- setup`).
        codex)
            case "${1:-}" in
                setup) shift; cmd_codex_setup "$@" ;;
                --)    shift; cmd_codex_launch "$@" ;;
                *)     cmd_codex_launch "$@" ;;
            esac
            ;;
        kimi)
            if [ "${1:-}" = "--" ]; then shift; fi
            cmd_kimi_launch "$@"
            ;;
        claude)
            case "${1:-}" in
                setup) shift; cmd_claude_setup "$@" ;;
                --)    shift; cmd_claude_launch "$@" ;;
                *)     cmd_claude_launch "$@" ;;
            esac
            ;;
        claude-desktop)
            case "${1:-}" in
                setup) shift; cmd_claude_desktop_setup "$@" ;;
                *) print_error "Usage: adp claude-desktop setup [--check] [--json]"; return 1 ;;
            esac
            ;;
        hermes)
            case "${1:-}" in
                setup) shift; cmd_hermes_setup "$@" ;;
                --)    shift; cmd_hermes_launch "$@" ;;
                *)     cmd_hermes_launch "$@" ;;
            esac
            ;;
        daemon)
            case "${1:-}" in
                install)   shift; cmd_daemon_install "$@" ;;
                uninstall) shift; cmd_daemon_uninstall "$@" ;;
                "")        print_error "Missing subcommand: 'adp daemon install' or 'adp daemon uninstall'."; exit 1 ;;
                *)         print_error "Unknown 'adp daemon' subcommand: $1"; exit 1 ;;
            esac
            ;;
        update)  cmd_update "$@" ;;
        version|--version|-v) echo "adp ${ADP_VERSION}" ;;
        help|--help|-h) usage ;;
        "")
            usage
            exit 1
            ;;
        *)
            print_error "Unknown command: ${command}"
            usage
            exit 1
            ;;
    esac
}

main "$@"
