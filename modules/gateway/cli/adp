#!/usr/bin/env bash
#
# adp — one front door for the ADP gateway CLI (Issue #4852, Phase 1).
#
# This is a THIN WRAPPER, deliberately. Every auth verb delegates to the
# already-tested core helper `bg-cognito-auth.sh` sitting next to this file, so
# there is exactly one implementation of login, token, refresh and the
# cross-process refresh lock (#4837) on the machine. The only genuinely new
# logic here is:
#
#   * `codex setup` / `claude setup` — idempotent, merge-never-overwrite config
#     writers, so users stop hand-editing two different tool config files
#   * `codex` / `claude`             — launchers: preflight the session, and (for
#     Codex only) ensure the local proxy is up, so launching is one command
#   * `daemon install|uninstall`     — opt-in always-on proxy, so bare `codex` works
#   * `status`                       — one read-only "am I set up correctly?"
#   * `update` / `update --rollback` — re-pull from the gateway that installed us
#
# There is exactly ONE authentication verb. Codex and Claude Code share the same
# on-disk token store (`~/.bedrock-gateway/`), so `adp login` seeds it once and
# both tools read it; the per-tool verbs do config wiring only and never
# authenticate.
#
# The two launchers are deliberately ASYMMETRIC in what they do, because the two
# tools are: Claude Code has an `apiKeyHelper` hook and calls `adp token` itself
# per request, so bare `claude` already works and `adp claude` adds only a
# fail-fast preflight. Codex has no such hook — it reads its credential from an
# env var once at launch — so it needs the loopback proxy running and a value in
# `ADP_GATEWAY_DUMMY`, which is what `adp codex` stops being a two-terminal
# chore. That asymmetry is documented, not hidden (Issue #4863).
#
# Usage:
#   adp login | status | logout | token | refresh | import | serve
#   adp codex [args…] | claude [args…]
#   adp codex setup | claude setup
#   adp daemon install | uninstall
#   adp update [--rollback] | version | help

set -euo pipefail

readonly ADP_VERSION="1.0.0"

# Same store the core helper uses — this wrapper adds no new secret location.
CONFIG_DIR="${HOME}/.bedrock-gateway"
CONFIG_FILE="${CONFIG_DIR}/config.json"
TOKEN_FILE="${CONFIG_DIR}/tokens.json"

CORE_SCRIPT_NAME="bg-cognito-auth.sh"
PROXY_SCRIPT_NAME="bg-gateway-proxy.py"
CLI_FILES="adp bg-cognito-auth.sh bg-gateway-proxy.py adp_common.py adp-admin.py adp-bedrock.py adp-aws.py adp-github.py adp-github-admin.py adp-superplane.py adp-models.py"

CODEX_CONFIG_FILE="${HOME}/.codex/config.toml"
CLAUDE_SETTINGS_FILE="${HOME}/.claude/settings.json"

# Where a detached proxy's output goes. A backgrounded process with nowhere to
# write is a process whose failure is invisible, and "Codex 502s on the first
# request" needs a log to diagnose.
ADP_LOG_DIR="${HOME}/.adp/logs"
PROXY_LOG_FILE="${ADP_LOG_DIR}/proxy.log"

# The core's serve pidfile. Read (never written) here, to tell "no proxy" from
# "a proxy on some other port" — the core refuses to run two, so the second is a
# distinct, actionable failure rather than a start timeout.
PROXY_PID_FILE="${CONFIG_DIR}/proxy.pid"

# Guards the proxy spawn so two concurrent `adp codex` calls cannot both start
# one. Deliberately NOT the core's refresh.lock: the proxy we spawn calls
# `token`, which takes that lock, so sharing it would deadlock the readiness
# poll against the process it is waiting for.
PROXY_SPAWN_LOCK_DIR="${CONFIG_DIR}/proxy-spawn.lock"
readonly PROXY_SPAWN_LOCK_STALE_SECONDS=30
readonly PROXY_SPAWN_LOCK_MAX_WAIT_SECONDS=15
_PROXY_SPAWN_LOCK_HELD=0

# How long to wait for a just-spawned proxy to accept connections. Generous
# enough for a cold python3 start, short enough that a proxy which will never
# come up fails with a legible message instead of hanging the terminal.
readonly PROXY_READY_TIMEOUT_SECONDS=10

# Opt-in always-on proxy (macOS launchd). Only `adp daemon` touches these.
LAUNCH_AGENT_LABEL="com.adp.gateway-proxy"
LAUNCH_AGENT_FILE="${HOME}/Library/LaunchAgents/${LAUNCH_AGENT_LABEL}.plist"

# Marker on the rc line `daemon install` adds, so `uninstall` can remove exactly
# that line and nothing else. Same shape as install.sh's PATH comment.
readonly DAEMON_RC_MARKER="# Added by adp daemon install"

# Codex provider block identifiers. The port must equal DEFAULT_PROXY_PORT in
# bg-cognito-auth.sh and CODEX_PROXY_PORT in frontend SetupInstructions.tsx.
#
# ADP_PROXY_PORT overrides it for the two cases where 9191 is not usable: a
# machine where something else already owns the port, and the test suite, which
# must not fight the developer's own running proxy. Both the config writer and
# the launcher read THIS variable, so an override cannot make config.toml's
# base_url disagree with the port we actually serve on — but a port changed after
# `codex setup` does require re-running it.
readonly CODEX_PROXY_PORT="${ADP_PROXY_PORT:-9191}"
readonly CODEX_PROVIDER="adp-gateway"

# 55 min. Matches cmd_token's refresh-on-expiry behaviour and the /setup page.
readonly CLAUDE_HELPER_TTL_MS=3300000

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_info() { echo -e "${BLUE}[INFO]${NC} $1" >&2; }
print_success() { echo -e "${GREEN}[OK]${NC} $1" >&2; }
print_warning() { echo -e "${YELLOW}[WARN]${NC} $1" >&2; }
print_error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

# Directory holding this script. `adp`, the core helper and the proxy install
# side by side (install.sh --prefix), so the core is resolved as a SIBLING
# rather than via PATH — the same resolution `serve` already uses to find the
# proxy. A PATH lookup could pick up an unrelated copy from ~/bin.
adp_dir() {
    local source="${BASH_SOURCE[0]}"
    local dir
    while [ -L "${source}" ]; do
        dir="$(cd -P "$(dirname "${source}")" && pwd)"
        source="$(readlink "${source}")"
        [[ "${source}" != /* ]] && source="${dir}/${source}"
    done
    cd -P "$(dirname "${source}")" && pwd
}

core_script() { echo "$(adp_dir)/${CORE_SCRIPT_NAME}"; }
proxy_script() { echo "$(adp_dir)/${PROXY_SCRIPT_NAME}"; }
adp_path() { echo "$(adp_dir)/$(basename "${BASH_SOURCE[0]}")"; }

# Delegate to the core helper. Every auth verb goes through here, so the flag
# surface the core defines stays the single source of truth.
core() {
    local core_path
    core_path="$(core_script)"
    if [ ! -f "${core_path}" ]; then
        print_error "Auth helper not found at ${core_path}."
        print_warning "Reinstall with: curl -fsSL <gateway>/api/cli/install.sh | sh -s -- --gateway-url <gateway>"
        exit 1
    fi
    bash "${core_path}" "$@"
}

check_dependencies() {
    local missing=()
    command -v curl >/dev/null 2>&1 || missing+=("curl")
    command -v jq >/dev/null 2>&1 || missing+=("jq")
    if [ ${#missing[@]} -ne 0 ]; then
        print_error "Missing dependencies: ${missing[*]}"
        exit 1
    fi
}

stored_gateway_url() {
    [ -f "${CONFIG_FILE}" ] || return 0
    jq -r '.gateway_url // empty' "${CONFIG_FILE}" 2>/dev/null || true
}

# True when a token file exists and its access token has not expired. Used only
# to refuse the `setup` verbs early with actionable copy — the setup writers
# themselves never authenticate.
has_valid_session() {
    [ -f "${TOKEN_FILE}" ] || return 1
    local expires_at now
    expires_at=$(jq -r '.expires_at // 0' "${TOKEN_FILE}" 2>/dev/null || echo 0)
    now=$(date +%s)
    [ -n "${expires_at}" ] && [ "${expires_at}" != "null" ] && [ "${now}" -lt "${expires_at}" ]
}

# The username claim from the stored access token, for `status` only. Decoding
# is deliberately best-effort: a status command must never fail because a JWT
# payload was shaped unusually. Base64url needs '-_' translated and the padding
# restored before base64(1) will accept it.
token_username() {
    local payload padded
    payload=$(jq -r '.access_token // empty' "${TOKEN_FILE}" 2>/dev/null | cut -d. -f2)
    [ -n "${payload}" ] || return 0
    payload=$(printf '%s' "${payload}" | tr '_-' '/+')
    padded="${payload}$(printf '%*s' $(((4 - ${#payload} % 4) % 4)) '' | tr ' ' '=')"
    printf '%s' "${padded}" | base64 -d 2>/dev/null \
        | jq -r '.username // .sub // empty' 2>/dev/null || true
}

require_session() {
    if [ ! -f "${CONFIG_FILE}" ] || [ ! -f "${TOKEN_FILE}" ]; then
        print_error "Not signed in — run 'adp login' first."
        exit 1
    fi
}

# --- launcher helpers (Issue #4863) -----------------------------------------

# The preflight both launchers run. Deliberately delegates to the core's
# `token`, NOT to has_valid_session: an EXPIRED ACCESS TOKEN IS NORMAL — it
# refreshes on next use, which is exactly what `token` does. Refusing to launch
# on that would be the "wrongly declares a valid session expired" failure mode.
# Only a genuinely dead session (no store, or a refresh token the gateway
# rejects) reaches the hint below.
require_live_session() {
    local tool="$1"

    if [ ! -f "${CONFIG_FILE}" ] || [ ! -f "${TOKEN_FILE}" ]; then
        print_error "Your CLI session has expired. Run: adp login"
        exit 1
    fi

    # Output discarded: this is a liveness check, and the token must never reach
    # a terminal or a log. Only the exit status is used.
    if ! core token >/dev/null 2>&1; then
        print_error "Your CLI session has expired. Run: adp login"
        print_warning "${tool} was not started."
        exit 1
    fi
}

# True when something is accepting connections on the proxy port.
#
# A TCP connect, not an HTTP request: every proxy route forwards upstream, so an
# HTTP probe would spend a real gateway call (and a token refresh) just to learn
# that a local socket is open. bash's /dev/tcp needs no nc/curl dependency.
#
# The connect happens in a SUBSHELL so the descriptor closes when it exits. Doing
# it in this shell would need a bare `exec 3>&-` to clean up, and a bare `exec`
# applies its redirections to the shell PERMANENTLY — `exec 3>&- 2>/dev/null`
# silently sends every later diagnostic, including "session expired", to
# /dev/null. Keep the probe inside the parentheses.
proxy_listening() {
    local port="$1"
    (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null
}

# Age in seconds of the spawn lock, or empty if absent. Portable across macOS
# (stat -f %m) and Linux (stat -c %Y) — mirrors _lock_age_seconds in the core.
_spawn_lock_age_seconds() {
    local mtime now
    if mtime=$(stat -f %m "${PROXY_SPAWN_LOCK_DIR}" 2>/dev/null); then
        :
    elif mtime=$(stat -c %Y "${PROXY_SPAWN_LOCK_DIR}" 2>/dev/null); then
        :
    else
        return 1
    fi
    now=$(date +%s)
    echo $((now - mtime))
}

_release_proxy_spawn_lock() {
    if [ "${_PROXY_SPAWN_LOCK_HELD}" = "1" ]; then
        rmdir "${PROXY_SPAWN_LOCK_DIR}" 2>/dev/null || rm -rf "${PROXY_SPAWN_LOCK_DIR}" 2>/dev/null || true
        _PROXY_SPAWN_LOCK_HELD=0
    fi
}

# mkdir is atomic across processes, which is the whole mechanism. Same
# stale-reclaim shape as the core's refresh lock (#4837): a lock abandoned by a
# crashed process must not wedge every later launch.
_acquire_proxy_spawn_lock() {
    mkdir -p "${CONFIG_DIR}" 2>/dev/null || true
    local waited=0
    while :; do
        if mkdir "${PROXY_SPAWN_LOCK_DIR}" 2>/dev/null; then
            _PROXY_SPAWN_LOCK_HELD=1
            trap _release_proxy_spawn_lock EXIT INT TERM
            return 0
        fi
        local age
        age=$(_spawn_lock_age_seconds || true)
        if [ -n "${age}" ] && [ "${age}" -ge "${PROXY_SPAWN_LOCK_STALE_SECONDS}" ]; then
            rmdir "${PROXY_SPAWN_LOCK_DIR}" 2>/dev/null || rm -rf "${PROXY_SPAWN_LOCK_DIR}" 2>/dev/null || true
            continue
        fi
        if [ "${waited}" -ge "${PROXY_SPAWN_LOCK_MAX_WAIT_SECONDS}" ]; then
            return 1
        fi
        sleep 1
        waited=$((waited + 1))
    done
}

# Block until the port accepts connections, or give up. Polls in 0.2s steps so a
# warm start costs a fraction of a second rather than a full second.
_wait_for_proxy() {
    local port="$1"
    local waited_tenths=0
    local limit_tenths=$((PROXY_READY_TIMEOUT_SECONDS * 10))
    while [ "${waited_tenths}" -lt "${limit_tenths}" ]; do
        if proxy_listening "${port}"; then
            return 0
        fi
        sleep 0.2
        waited_tenths=$((waited_tenths + 2))
    done
    return 1
}

# Make sure a proxy is listening on CODEX_PROXY_PORT, starting one if not.
#
# Idempotent by health-check-first: an already-running proxy (yours, or the
# launchd agent from `adp daemon install`) is reused, never duplicated. The
# re-check under the lock is what makes two concurrent `adp codex` calls start
# exactly one proxy — the loser of the mkdir race observes the winner's proxy
# instead of racing it to the bind.
ensure_proxy() {
    local port="${CODEX_PROXY_PORT}"

    if proxy_listening "${port}"; then
        print_info "Using the auth proxy already running on 127.0.0.1:${port}."
        return 0
    fi

    if ! _acquire_proxy_spawn_lock; then
        print_error "Could not acquire the proxy start lock within ${PROXY_SPAWN_LOCK_MAX_WAIT_SECONDS}s."
        print_warning "Another launch may be stuck — remove ${PROXY_SPAWN_LOCK_DIR} if no other session is starting."
        exit 1
    fi

    if proxy_listening "${port}"; then
        _release_proxy_spawn_lock
        print_info "Using the auth proxy already running on 127.0.0.1:${port}."
        return 0
    fi

    # Nothing on our port, but the core keeps ONE pidfile regardless of port and
    # refuses to start a second proxy. Without this check that refusal surfaces
    # as a 10s "did not come up" timeout with the real reason buried in the log —
    # so name it now, with the fix.
    if [ -f "${PROXY_PID_FILE}" ]; then
        local existing_pid
        existing_pid=$(cat "${PROXY_PID_FILE}" 2>/dev/null || true)
        if [ -n "${existing_pid}" ] && kill -0 "${existing_pid}" 2>/dev/null; then
            _release_proxy_spawn_lock
            print_error "An auth proxy is already running (pid ${existing_pid}), but not on port ${port}."
            print_warning "Stop it with 'kill ${existing_pid}', or re-run 'adp codex setup' to use its port."
            exit 1
        fi
    fi

    mkdir -p "${ADP_LOG_DIR}" 2>/dev/null || true

    print_info "Starting the auth proxy on 127.0.0.1:${port} (log: ${PROXY_LOG_FILE})..."
    # setsid where available so the proxy survives this terminal; nohup covers
    # the rest. stdin from /dev/null and both streams appended to the log, so a
    # detached proxy can neither read from nor scribble on the user's terminal.
    if command -v setsid >/dev/null 2>&1; then
        setsid nohup bash "$(core_script)" serve --port "${port}" \
            </dev/null >>"${PROXY_LOG_FILE}" 2>&1 &
    else
        nohup bash "$(core_script)" serve --port "${port}" \
            </dev/null >>"${PROXY_LOG_FILE}" 2>&1 &
    fi
    disown 2>/dev/null || true

    if ! _wait_for_proxy "${port}"; then
        _release_proxy_spawn_lock
        print_error "The auth proxy did not come up within ${PROXY_READY_TIMEOUT_SECONDS}s."
        print_warning "See ${PROXY_LOG_FILE}, or run 'adp serve' in the foreground to watch it start."
        exit 1
    fi

    # Released only once the proxy is listening: a waiter that took the lock the
    # moment we spawned would health-check a socket that is not open yet and
    # spawn a second.
    _release_proxy_spawn_lock
    print_success "Auth proxy ready on 127.0.0.1:${port}."
}

require_tool() {
    local tool="$1"
    if ! command -v "${tool}" >/dev/null 2>&1; then
        print_error "${tool} is not on your PATH — install it first."
        exit 1
    fi
}

# --- codex (launch) ---------------------------------------------------------
# One command, one terminal. Replaces the `adp serve` + `ADP_GATEWAY_DUMMY=unused
# codex` two-terminal dance: preflight the session, ensure the proxy, set the
# placeholder env var Codex insists on, hand over.
cmd_codex_launch() {
    require_tool codex
    require_live_session "Codex"
    ensure_proxy

    # Codex refuses to start a model provider whose env_key names an unset
    # variable, but never validates the VALUE — the proxy drops whatever arrives
    # and injects the real token. So this is a placeholder, not a credential,
    # and setting it here is what removes it from the user's command line.
    export ADP_GATEWAY_DUMMY="${ADP_GATEWAY_DUMMY:-unused}"

    # exec, so Codex owns the terminal: job control, Ctrl-C and its exit status
    # all reach the user directly instead of through a bash wrapper.
    exec codex "$@"
}

# --- claude (launch) --------------------------------------------------------
# Preflight, then hand over. No proxy and no env var by design: Claude Code's
# apiKeyHelper calls `adp token` per request, so bare `claude` works and keeps
# working. This verb exists for symmetry and for the fail-fast login hint.
cmd_claude_launch() {
    require_tool claude
    require_live_session "Claude Code"
    exec claude "$@"
}

# --- login ------------------------------------------------------------------
# The ONE auth verb: browser-approval sign-in on the CLI Cognito client. Maps
# to the core's `login --web`; `--gateway-url` falls back to the URL install.sh
# persisted, so a first `adp login` needs no flags.
cmd_login() {
    local args=()
    local gateway_url=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --gateway-url)
                gateway_url="${2:-}"
                shift 2
                ;;
            --no-browser)
                args+=("--no-browser")
                shift
                ;;
            *)
                print_error "Unknown option for 'login': $1"
                exit 1
                ;;
        esac
    done

    if [ -z "${gateway_url}" ]; then
        gateway_url="$(stored_gateway_url)"
    fi
    if [ -z "${gateway_url}" ]; then
        print_error "No gateway URL known. Pass --gateway-url <url>, or reinstall with:"
        print_warning "  curl -fsSL <gateway>/api/cli/install.sh | sh -s -- --gateway-url <gateway>"
        exit 1
    fi

    core login --web --gateway-url "${gateway_url}" "${args[@]}"
}

# --- status -----------------------------------------------------------------
# Read-only day-1 confirmation and day-N "am I still good?". Exits non-zero
# when there is no session, so it is usable in a script.
cmd_status() {
    if [ ! -f "${CONFIG_FILE}" ]; then
        echo "Not signed in."
        echo "Run 'adp login' to sign in."
        return 1
    fi

    local gateway_url refresh_via
    gateway_url=$(jq -r '.gateway_url // empty' "${CONFIG_FILE}")
    refresh_via=$(jq -r '.refresh_via // empty' "${CONFIG_FILE}")
    [ -n "${refresh_via}" ] || refresh_via="cognito"

    if [ ! -f "${TOKEN_FILE}" ]; then
        echo "Not signed in."
        echo "Gateway:      ${gateway_url}"
        echo "Run 'adp login' to sign in."
        return 1
    fi

    local user
    user="$(token_username)"
    [ -n "${user}" ] || user="(unknown)"

    local expires_at now remaining
    expires_at=$(jq -r '.expires_at // 0' "${TOKEN_FILE}")
    now=$(date +%s)
    remaining=$((expires_at - now))

    echo "Signed in as: ${user}"
    echo "Gateway:      ${gateway_url}"
    echo "Refresh mode: ${refresh_via}"
    if [ "${remaining}" -gt 0 ]; then
        echo "Access token: valid, $((remaining / 60)) minutes remaining"
    else
        echo "Access token: expired — it refreshes automatically on next use"
    fi
    return 0
}

# --- codex setup ------------------------------------------------------------
# Config wiring only. Codex has no apiKeyHelper hook, so the token is injected
# by the local proxy (`adp serve`) — nothing secret is ever written here.
#
# Rewrites ONLY the `model_provider` line and the [model_providers.adp-gateway]
# block; the rest of the user's TOML is preserved verbatim so an existing Codex
# setup is not clobbered. Running it twice produces the same file.
cmd_codex_setup() {
    require_session

    local proxy
    proxy="$(proxy_script)"
    if [ ! -f "${proxy}" ]; then
        print_error "${PROXY_SCRIPT_NAME} is missing from $(adp_dir)."
        print_warning "Codex needs it: 'adp serve' runs it as a sibling of the auth helper."
        print_warning "Reinstall with: curl -fsSL <gateway>/api/cli/install.sh | sh -s -- --gateway-url <gateway>"
        exit 1
    fi

    mkdir -p "$(dirname "${CODEX_CONFIG_FILE}")"

    # Everything we do NOT own, preserved verbatim. awk (not sed) because the
    # provider block is multi-line: it ends at the next [section] header.
    # $(...) drops trailing newlines, which is what makes a second run
    # byte-identical to the first.
    local preserved=""
    if [ -f "${CODEX_CONFIG_FILE}" ]; then
        preserved=$(awk -v provider="[model_providers.${CODEX_PROVIDER}]" '
            {
                line = $0
                sub(/^[[:space:]]+/, "", line)
                sub(/[[:space:]]+$/, "", line)
            }
            line ~ /^\[/ { in_block = (line == provider); if (in_block) next }
            in_block { next }
            line ~ /^model_provider[[:space:]]*=/ { next }
            # Suppress the leading blank line that removing our own top-level
            # key leaves behind — otherwise every run would add one and the
            # second run would not be a no-op. ($(...) strips trailing ones.)
            NF { started = 1 }
            started { print }
        ' "${CODEX_CONFIG_FILE}")
    fi

    local tmp
    tmp=$(mktemp "${CODEX_CONFIG_FILE}.XXXXXX")

    # `model_provider` is a TOP-LEVEL key, so it must precede every [section]
    # header: in TOML a bare key written after a header belongs to that table,
    # and appending it at the end of a file with an [mcp_servers.x] block would
    # silently define mcp_servers.x.model_provider instead. Hence: our key
    # first, the user's content next, our provider block last (a header, so it
    # is position-safe).
    printf 'model_provider = "%s"\n' "${CODEX_PROVIDER}" > "${tmp}"
    if [ -n "${preserved}" ]; then
        printf '\n%s\n' "${preserved}" >> "${tmp}"
    fi

    cat >> "${tmp}" << EOF

[model_providers.${CODEX_PROVIDER}]
name = "${CODEX_PROVIDER}"
base_url = "http://127.0.0.1:${CODEX_PROXY_PORT}/openai/v1"
wire_api = "responses"
env_key = "ADP_GATEWAY_DUMMY"
EOF

    mv -f "${tmp}" "${CODEX_CONFIG_FILE}"
    print_success "Wired Codex to the ADP gateway (${CODEX_CONFIG_FILE})."
    echo ""
    echo "Run it — one command, one terminal:"
    echo ""
    echo "  adp codex"
    echo ""
    echo "That starts the local auth proxy if it is not already up, then hands you"
    echo "into Codex. To make the bare 'codex' command work too, run:"
    echo ""
    echo "  adp daemon install"
    echo ""
}

# --- claude setup -----------------------------------------------------------
# MERGES into ~/.claude/settings.json — never overwrites. A user's other Claude
# settings (permissions, MCP servers, hooks) must survive, so the write is a
# jq object-merge of only the keys we own.
#
# apiKeyHelper uses the ABSOLUTE installed path: Claude Code may invoke it from
# a non-login shell where the install dir is not on PATH.
cmd_claude_setup() {
    require_session

    local gateway_url
    gateway_url="$(stored_gateway_url)"
    if [ -z "${gateway_url}" ]; then
        print_error "No gateway URL in ${CONFIG_FILE} — run 'adp login' first."
        exit 1
    fi

    mkdir -p "$(dirname "${CLAUDE_SETTINGS_FILE}")"

    local existing="{}"
    if [ -f "${CLAUDE_SETTINGS_FILE}" ]; then
        if ! existing=$(jq '.' "${CLAUDE_SETTINGS_FILE}" 2>/dev/null); then
            print_error "${CLAUDE_SETTINGS_FILE} is not valid JSON — fix or move it, then re-run."
            exit 1
        fi
    fi

    # `env` is merged key-by-key (`*`) so unrelated env entries survive; the
    # scalar keys we own are replaced outright. Shape mirrors
    # buildBedrockSettings() in frontend/src/components/setup/SetupInstructions.tsx.
    local merged
    merged=$(printf '%s' "${existing}" | jq \
        --arg base_url "${gateway_url}" \
        --arg helper "$(adp_path) token" \
        --argjson ttl "${CLAUDE_HELPER_TTL_MS}" \
        '. as $orig
         | .env = (($orig.env // {}) * {
               AWS_REGION: (($orig.env // {}).AWS_REGION // "us-east-1"),
               CLAUDE_CODE_USE_BEDROCK: "1",
               CLAUDE_CODE_SKIP_BEDROCK_AUTH: "1",
               ANTHROPIC_BEDROCK_BASE_URL: $base_url
             })
         | .apiKeyHelper = $helper
         | .apiKeyHelperTtlMs = $ttl')

    local tmp
    tmp=$(mktemp "${CLAUDE_SETTINGS_FILE}.XXXXXX")
    printf '%s\n' "${merged}" > "${tmp}"
    chmod 600 "${tmp}"
    mv -f "${tmp}" "${CLAUDE_SETTINGS_FILE}"

    print_success "Wired Claude Code to the ADP gateway (${CLAUDE_SETTINGS_FILE})."
    echo ""
    echo "Run it:"
    echo ""
    echo "  claude"
    echo ""
}

# --- daemon install / uninstall ---------------------------------------------
# OPT-IN ONLY. The default is the on-demand `adp codex` launcher: no background
# service, no rc edit, and the proxy dies with your session. This exists for
# people who want the bare word `codex` to work, which needs the proxy always up
# and ADP_GATEWAY_DUMMY exported by the shell rather than by the launcher.
#
# Not implemented by shadowing `codex` with a shell function or alias: a wrapper
# that silently intercepts a binary you installed yourself is too surprising, and
# is an explicit non-goal of #4863.
#
# macOS/launchd only. Adding a second init system (systemd --user) is a separate
# piece of work, and shipping a half-tested Linux path would be worse than
# saying so.
daemon_rc_file() {
    case "${SHELL:-}" in
        */zsh) echo "${HOME}/.zshrc" ;;
        */bash)
            if [ -f "${HOME}/.bash_profile" ]; then echo "${HOME}/.bash_profile"; else echo "${HOME}/.bashrc"; fi ;;
        *) echo "" ;;
    esac
}

require_launchd() {
    if [ "$(uname -s)" != "Darwin" ] || ! command -v launchctl >/dev/null 2>&1; then
        print_error "'adp daemon' needs macOS launchd."
        print_warning "On Linux, 'adp codex' starts the proxy on demand — no daemon needed."
        exit 1
    fi
}

# Remove our marked rc block if present. Written to be safe to call when the rc
# file does not exist or has no block, so `uninstall` is idempotent.
daemon_remove_rc_export() {
    local rc="$1"
    [ -n "${rc}" ] && [ -f "${rc}" ] || return 0
    grep -Fq "${DAEMON_RC_MARKER}" "${rc}" || return 0

    local tmp
    tmp=$(mktemp "${rc}.XXXXXX")
    # Drops the marker line and the export that follows it, leaving every other
    # line — including any ADP_GATEWAY_DUMMY the user set themselves — untouched.
    awk -v marker="${DAEMON_RC_MARKER}" '
        index($0, marker) { skip = 1; next }
        skip && $0 ~ /^export ADP_GATEWAY_DUMMY=/ { skip = 0; next }
        { skip = 0; print }
    ' "${rc}" > "${tmp}"
    mv -f "${tmp}" "${rc}"
    print_success "Removed the ADP_GATEWAY_DUMMY export from ${rc}."
}

cmd_daemon_install() {
    require_launchd
    require_session

    local core_path
    core_path="$(core_script)"
    if [ ! -f "${core_path}" ]; then
        print_error "Auth helper not found at ${core_path} — reinstall the CLI first."
        exit 1
    fi

    mkdir -p "$(dirname "${LAUNCH_AGENT_FILE}")" "${ADP_LOG_DIR}"

    # KeepAlive so a crashed proxy comes back; RunAtLoad so it is up after a
    # reboot without the user thinking about it. Both streams to the same log the
    # on-demand launcher uses, so there is one place to look either way.
    cat > "${LAUNCH_AGENT_FILE}" << EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${LAUNCH_AGENT_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>${core_path}</string>
        <string>serve</string>
        <string>--port</string>
        <string>${CODEX_PROXY_PORT}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${PROXY_LOG_FILE}</string>
    <key>StandardErrorPath</key>
    <string>${PROXY_LOG_FILE}</string>
</dict>
</plist>
EOF

    # Unload first so a re-run picks up a changed plist instead of leaving the
    # old definition loaded. Failure is expected when nothing is loaded yet.
    launchctl unload "${LAUNCH_AGENT_FILE}" 2>/dev/null || true
    if ! launchctl load "${LAUNCH_AGENT_FILE}" 2>/dev/null; then
        print_warning "Wrote ${LAUNCH_AGENT_FILE} but launchctl load failed."
        print_warning "Load it at next login, or run: launchctl load ${LAUNCH_AGENT_FILE}"
    fi

    # Bare `codex` gets ADP_GATEWAY_DUMMY from the shell, since no launcher is
    # involved to set it. Marked and idempotent so a re-run does not stack lines.
    local rc
    rc="$(daemon_rc_file)"
    if [ -z "${rc}" ]; then
        print_warning "Unknown shell — add this to your shell config yourself:"
        printf '\n    export ADP_GATEWAY_DUMMY=unused\n\n' >&2
    elif [ -f "${rc}" ] && grep -Fq "${DAEMON_RC_MARKER}" "${rc}"; then
        print_success "${rc} already exports ADP_GATEWAY_DUMMY."
    else
        {
            echo ""
            echo "${DAEMON_RC_MARKER}"
            echo "export ADP_GATEWAY_DUMMY=unused"
        } >> "${rc}"
        print_success "Added the ADP_GATEWAY_DUMMY export to ${rc}."
    fi

    print_success "Always-on auth proxy installed (${LAUNCH_AGENT_LABEL})."
    echo ""
    echo "Open a new terminal, then run Codex however you like:"
    echo ""
    echo "  codex        # bare — the proxy is always up now"
    echo "  adp codex    # also fine; it finds the running proxy and reuses it"
    echo ""
    echo "Undo with: adp daemon uninstall"
    echo ""
}

cmd_daemon_uninstall() {
    require_launchd

    local removed=0
    if [ -f "${LAUNCH_AGENT_FILE}" ]; then
        launchctl unload "${LAUNCH_AGENT_FILE}" 2>/dev/null || true
        rm -f "${LAUNCH_AGENT_FILE}"
        print_success "Removed ${LAUNCH_AGENT_FILE}."
        removed=1
    fi

    daemon_remove_rc_export "$(daemon_rc_file)"

    if [ "${removed}" -eq 0 ]; then
        print_info "No always-on proxy was installed — nothing to remove."
    fi

    print_success "Done. 'adp codex' still works — it starts the proxy on demand."
}

# Python area commands resolve installed siblings, just like the auth helper.
exec_python_helper() {
    local helper="$(adp_dir)/$1"
    shift
    if ! command -v python3 >/dev/null 2>&1; then
        print_error "Python 3 is required for this command."; exit 1
    fi
    if [ ! -f "${helper}" ]; then
        print_error "CLI helper missing. Run adp update."; exit 1
    fi
    exec python3 "${helper}" "$@"
}

# --- update -----------------------------------------------------------------
# The ADP_VERSION a given copy of this script declares. Read from the file rather
# than from a manifest, so a version claim is always checked against the code that
# would actually run (Issue #5039).
declared_version() {
    [ -f "$1" ] || return 0
    sed -n 's/^readonly ADP_VERSION="\([^"]*\)".*/\1/p' "$1" 2>/dev/null | head -n 1
}

# Re-pull install.sh from the gateway that installed us and re-run it against
# the same prefix. The previous copies are kept as *.prev for --rollback, which
# is the mitigation for "adp update pulled a broken CLI".
#
# Issue #5039: `--to <version>` makes both directions version-explicit. An
# unpinned target (a range, a tag, "latest") is rejected rather than resolved,
# because resolving it would reintroduce exactly the "update installed something
# I did not choose" behaviour the pin exists to prevent. Bare `adp update` and
# bare `--rollback` keep their existing meaning.
cmd_update() {
    local rollback=0
    local target=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --rollback) rollback=1; shift ;;
            # Issue #5039: name the version explicitly. `--to` is what makes an
            # update or rollback verifiable — without it, "update" means whatever
            # the gateway happens to serve now and "rollback" means one anonymous
            # generation back.
            --to)
                if [ -z "${2:-}" ]; then print_error "--to requires a version, for example --to 1.0.0"; exit 1; fi
                target="$2"; shift 2 ;;
            --to=*) target="${1#--to=}"; shift ;;
            *) print_error "Unknown option for 'update': $1"; exit 1 ;;
        esac
    done

    if [ -n "${target}" ] && ! [[ "${target}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        print_error "--to needs an exact version like 1.0.0, not '${target}'."
        print_warning "A range or tag would not pin anything; only an exact version is accepted."
        exit 1
    fi

    local dir
    dir="$(adp_dir)"

    if [ "${rollback}" -eq 1 ]; then
        # A rollback target is verified against what the .prev copies ACTUALLY
        # declare, before anything is moved. Trusting the manifest alone would
        # let a mismatched pair silently restore the wrong version.
        if [ -n "${target}" ]; then
            local previous_version
            previous_version="$(declared_version "${dir}/adp.prev")"
            if [ -z "${previous_version}" ]; then
                print_error "No previous version to roll back to."
                exit 1
            fi
            if [ "${previous_version}" != "${target}" ]; then
                print_error "Rollback target ${target} is not available; the previous version here is ${previous_version}."
                print_warning "Roll back to it with 'adp update --rollback --to ${previous_version}', or reinstall pinned to ${target}."
                exit 1
            fi
        fi

        local restored=0
        local name
        for name in ${CLI_FILES}; do
            if [ -f "${dir}/${name}.prev" ]; then
                mv -f "${dir}/${name}.prev" "${dir}/${name}"
                restored=1
            fi
        done
        if [ "${restored}" -eq 0 ]; then
            print_error "No previous version to roll back to."
            exit 1
        fi
        chmod +x "${dir}/adp" "${dir}/${CORE_SCRIPT_NAME}" 2>/dev/null || true
        print_success "Rolled back to CLI version $(declared_version "${dir}/adp")."
        return 0
    fi

    local gateway_url
    gateway_url="$(stored_gateway_url)"
    if [ -z "${gateway_url}" ]; then
        print_error "No gateway URL in ${CONFIG_FILE} — cannot tell where to update from."
        print_warning "Reinstall with: curl -fsSL <gateway>/api/cli/install.sh | sh -s -- --gateway-url <gateway>"
        exit 1
    fi

    local installer
    installer=$(mktemp)
    # shellcheck disable=SC2064  # expand now: the path must survive the trap.
    trap "rm -f '${installer}'" EXIT
    if ! curl -fsSL "${gateway_url%/}/cli/install.sh" -o "${installer}"; then
        print_error "Could not download install.sh from ${gateway_url%/}/cli/install.sh"
        exit 1
    fi

    print_info "Updating from ${gateway_url%/}..."
    # A pinned update passes the pin through: install.sh verifies the served
    # version against it and installs nothing on a mismatch, so `--to` either
    # lands exactly that version or changes nothing.
    if [ -n "${target}" ]; then
        ADP_KEEP_PREVIOUS=1 bash "${installer}" --prefix "${dir}" --gateway-url "${gateway_url}" --version-pin "${target}"
        print_success "Updated to ${target}. 'adp update --rollback' restores the previous version."
        return 0
    fi
    ADP_KEEP_PREVIOUS=1 bash "${installer}" --prefix "${dir}" --gateway-url "${gateway_url}"
    print_success "Updated to $(declared_version "${dir}/adp"). 'adp update --rollback' restores the previous version."
}

usage() {
    cat << EOF
adp ${ADP_VERSION} — one command for the ADP gateway CLI

Usage:
    adp <command> [options]

Sign in (one login is shared by every tool):
    login [--gateway-url <url>] [--no-browser]
                          Browser-approval sign-in — no password, nothing pasted
    status                Signed-in user, token validity, gateway, refresh mode
    logout                Clear the local token store
    refresh               Force a token refresh now
    import                Headless fallback: paste a refresh token
    token                 Print a valid access token (auto-refreshing)

Connect your own AWS account:
    aws connect           Connect an AWS account (create the role, or reuse one)
    aws list              Show your AWS connections
    aws verify            Check a connection still works
    aws disconnect        Remove an ADP connection (leaves the AWS role)

Wire up a tool (config only — sign in once, then set up as many as you like):
    codex setup           Point Codex at the local auth proxy
    claude setup          Set Claude Code's apiKeyHelper (merges settings.json)

Run a tool:
    codex [args...]       Launch Codex: starts the auth proxy if needed, then execs
    claude [args...]      Launch Claude Code (optional — bare 'claude' also works)
    serve                 Run the localhost auth proxy in the FOREGROUND

Connect a repository (uses the platform's GitHub App — you supply no secrets):
    github connect --repo owner/name
                          Authorize a repository you have access to on GitHub
    github status [--repo owner/name]
                          Sign-in, repository access and agent integration state

Self-management:
    daemon install        Opt in to an always-on proxy, so bare 'codex' works (macOS)
    daemon uninstall      Remove it

Run GPU workloads (uses the same sign-in — no second token to manage):
    superplane workspace    Create, list, select and describe workspaces
    superplane deploy       Deploy models, list and delete deployments
    superplane node|cost|events|quota
                            Nodes, spend, recent activity and workspace quota
    superplane account|aws-onboard
                            Register cloud accounts for Superplane
    superplane provider add Store a provider credential in ADP's vault (prompted)

Configure agent persona models:
    models catalog --persona KEY
    models mappings list|set|reset
    models explain --persona KEY
    models service-principals list

  Administration:
    admin login           Sign in with a Cognito administrator account
    admin setup           Check and resume first-time setup
    admin bedrock         Connect AWS destinations and manage model routing
    admin github          Configure this deployment's GitHub App and check it
    bedrock status        Show your effective Bedrock destination
    update [--to <version>]
                          Re-pull this CLI from your gateway; --to pins the exact
                          version and installs nothing if it is not what is served
    update --rollback [--to <version>]
                          Restore the previous version (--to verifies which)
    version               Print the version
    help                  Show this message

Day 1, start to finish:
    curl -fsSL https://<gateway>/api/cli/install.sh | sh -s -- --gateway-url https://<gateway>
    adp login
    adp status
    adp codex setup        # or: adp claude setup
    adp codex              # or: claude

Why the two launchers differ:
    Codex has no hook for refreshing a credential, so it needs the local proxy
    running and a placeholder in ADP_GATEWAY_DUMMY — 'adp codex' does both for
    you. Claude Code calls 'adp token' itself on every request, so bare 'claude'
    already works; 'adp claude' just fails fast with a login hint instead of
    erroring mid-session. Args after either verb go straight to the tool.
EOF
}

main() {
    check_dependencies

    local command="${1:-}"
    shift || true

    case "${command}" in
        aws)     exec_python_helper "adp-aws.py" "$@" ;;
        bedrock) exec_python_helper "adp-bedrock.py" "$@" ;;
        admin)   exec_python_helper "adp-admin.py" "$@" ;;
        github)  exec_python_helper "adp-github.py" "$@" ;;
        # Superplane workloads (Issue #5039). Goes through the same helper path
        # as the areas above, so it inherits ONE credential path: the session
        # `adp login` already established. The extension has no token store of
        # its own — that is the whole point of the verb existing here rather
        # than as a separate `superplane` CLI on the user's PATH.
        superplane) exec_python_helper "adp-superplane.py" "$@" ;;
        models) exec_python_helper "adp-models.py" "$@" ;;
        login)   cmd_login "$@" ;;
        status)  cmd_status "$@" ;;
        # Pure pass-throughs. The core owns their flags and their exit codes.
        logout|token|refresh|import|serve)
                 core "${command}" "$@" ;;
        # `setup` is our own subcommand; anything else — including nothing at all
        # — is a LAUNCH with passthrough args. Codex and Claude both have rich
        # flag surfaces we must not shadow, so the tool owns every token we do
        # not claim, and `--` before an arg that collides with `setup` is the
        # escape hatch (`adp codex -- setup`).
        codex)
            case "${1:-}" in
                setup) shift; cmd_codex_setup "$@" ;;
                --)    shift; cmd_codex_launch "$@" ;;
                *)     cmd_codex_launch "$@" ;;
            esac
            ;;
        claude)
            case "${1:-}" in
                setup) shift; cmd_claude_setup "$@" ;;
                --)    shift; cmd_claude_launch "$@" ;;
                *)     cmd_claude_launch "$@" ;;
            esac
            ;;
        daemon)
            case "${1:-}" in
                install)   shift; cmd_daemon_install "$@" ;;
                uninstall) shift; cmd_daemon_uninstall "$@" ;;
                "")        print_error "Missing subcommand: 'adp daemon install' or 'adp daemon uninstall'."; exit 1 ;;
                *)         print_error "Unknown 'adp daemon' subcommand: $1"; exit 1 ;;
            esac
            ;;
        update)  cmd_update "$@" ;;
        version|--version|-v) echo "adp ${ADP_VERSION}" ;;
        help|--help|-h) usage ;;
        "")
            usage
            exit 1
            ;;
        *)
            print_error "Unknown command: ${command}"
            usage
            exit 1
            ;;
    esac
}

main "$@"
