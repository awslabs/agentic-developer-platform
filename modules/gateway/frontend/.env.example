# Bedrock Gateway Frontend Environment Variables
# Copy this file to .env.local for local development

# API URL (defaults to /api for production proxy)
VITE_API_URL=/api

# Cognito OAuth Configuration
# These values should match your Cognito User Pool configuration
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your-client-id-here
VITE_COGNITO_DOMAIN=bedrockgw-dev-auth
VITE_COGNITO_REGION=us-east-1

# OAuth Redirect URI (must match callback URL configured in Cognito)
# For local development: http://localhost:5173/auth/callback
# For production: https://your-cloudfront-domain/auth/callback
VITE_REDIRECT_URI=http://localhost:5173/auth/callback
