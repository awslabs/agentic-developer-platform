      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app.kubernetes.io/name": "tool-adapters",
          "app.kubernetes.io/part-of": "adp"
        },
        "ports": [
          {
            "name": "http",
            "port": 80,
            "targetPort": "http"
          }
        ]
      }
    },
    {
      "apiVersion": "policy/v1",
      "kind": "PodDisruptionBudget",
      "metadata": {
        "name": "tool-adapters",
        "namespace": "adp-tools",
        "labels": {
          "app.kubernetes.io/name": "tool-adapters",
          "app.kubernetes.io/part-of": "adp"
        }
      },
      "spec": {
        "minAvailable": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "tool-adapters",
            "app.kubernetes.io/part-of": "adp"
          }
        }
      }
    }
  ]
}
