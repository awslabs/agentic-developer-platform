#!/var/lang/bin/python3.12
"""Detached acceptance checks for the bounded developer qualification branch."""
import importlib.util
from pathlib import Path

source = Path("/work/qualification/6196/branch_name.py")
spec = importlib.util.spec_from_file_location("qualification_branch_name", source)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
cases = [
    ("  Feature: Add API /v2  ", "feature-add-api-v2"),
    ("Fix___Login", "fix-login"),
    ("___", "task"),
    ("Résumé—Release", "resume-release"),
    ("A" * 60, "a" * 48),
    ("a" * 47 + "---b", "a" * 47),
    ("already-valid", "already-valid"),
]
for value, expected in cases:
    actual = module.normalize_branch_name(value)
    assert actual == expected, f"{value!r}: expected {expected!r}, got {actual!r}"
print(f"{len(cases)} detached branch-name acceptance checks passed")
