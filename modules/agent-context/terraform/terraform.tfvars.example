# Agent Context Platform — Terraform Variables
# Copy to terraform.tfvars and fill in your values.
#
# When deployed as part of ADP, use:
#   terraform init -backend-config="../../../environments/dev/modules/agent-context-backend.tfvars"
#   terraform apply -var-file="../../../environments/dev/modules/agent-context.tfvars"

environment = "dev"
account_id  = "123456789012"
aws_region  = "us-east-1"

# VPC, EKS, subnets are read from platform remote state — no need to set them.

tags = {
  Team = "agent-context"
}

# --- GraphRAG (Neptune Serverless + OpenSearch Serverless) ---
# WARNING: expensive. Keep disabled unless needed.
# graphrag_enabled = true
# neptune_min_capacity = 1.0
# neptune_max_capacity = 16.0
# opensearch_collection_name = "graphrag-entities"
# opensearch_allow_public_access = false  # Default: VPC-only (recommended)
