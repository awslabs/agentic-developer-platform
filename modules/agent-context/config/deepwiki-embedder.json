{
  "embedder": {
    "client_class": "OpenAIClient",
    "batch_size": 100,
    "model_kwargs": {
      "model": "bedrock/amazon.titan-embed-text-v2:0",
      "dimensions": 256,
      "encoding_format": "float"
    }
  },
  "retriever": {
    "top_k": 20
  },
  "text_splitter": {
    "split_by": "word",
    "chunk_size": 350,
    "chunk_overlap": 100
  }
}
