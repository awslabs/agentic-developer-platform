#!/usr/bin/env bash
# Agent Context Intelligence Platform - Configuration
# Copy to config.local.env and customize for your environment.
# All scripts source this file (and config.local.env if present).

# --- Cluster -----------------------------------------------------------------
CLUSTER_NAME="adp-dev-eks-cluster"
AWS_REGION="us-east-1"
NAMESPACE="agent-context"
SERVICE_ACCOUNT="agent-context-sa"
STORAGE_CLASS="ebs-gp3"

# --- Personal Context Only Mode -----------------------------------------------
# Deploy lean stack only: OpenViking + LiteLLM + Context MCP + Synthesis CronJob.
# Skips Sourcebot, DeepWiki, ingestion pipeline, OpenSearch. Neptune only if
# GRAPHRAG_ENABLED=true. Cost: ~$280/mo (vs ~$800/mo full stack).
# Can also be activated via: ./deploy.sh --personal-context-only
PERSONAL_CONTEXT_ONLY="${PERSONAL_CONTEXT_ONLY:-false}"

# --- S3 Files Storage --------------------------------------------------------
# Set to "false" to use legacy EBS PVCs instead of S3-backed file systems
S3_FILES_ENABLED="${S3_FILES_ENABLED:-true}"
S3_FILES_BUCKET="agent-context-platform-data-879318057152"

# --- GitHub App (for Sourcebot token rotation) --------------------------------
# Stored as separate secrets in AWS Secrets Manager (matches GitHub Actions workflow pattern)
GITHUB_APP_OWNER="aws-e"
# Split secrets (org-namespaced path matching ADP conventions)
GITHUB_APP_ID_SECRET="adp/aws-e/gh-app-ops-id"
GITHUB_APP_KEY_SECRET="adp/aws-e/gh-app-ops-key"
# Legacy combined secret (uncomment if using single JSON secret instead)
# GITHUB_APP_SECRET_ID="adp/github-app"
SECRETS_MANAGER_REGION="${AWS_REGION}"

# --- Bedrock Embedding Model --------------------------------------------------
# Primary: cohere.embed-v4:0  Fallback: amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_MODEL="amazon.titan-embed-text-v2:0"
BEDROCK_EMBEDDING_DIMENSION=1024
BEDROCK_REGION="${AWS_REGION}"

# --- VLM (via LiteLLM proxy -> Bedrock) --------------------------------------
BEDROCK_VLM_MODEL="global.anthropic.claude-sonnet-4-6"
VLM_MAX_CONCURRENT=50
VLM_MAX_RETRIES=3

# --- Repo Ingestion -----------------------------------------------------------
REPOS_FILE="${REPOS_FILE:-index_content/repos.txt}"

# --- LiteLLM Proxy ------------------------------------------------------------
LITELLM_PORT=4000
LITELLM_IMAGE="python:3.11-slim"

# --- Sourcebot ----------------------------------------------------------------
SOURCEBOT_IMAGE="ghcr.io/sourcebot-dev/sourcebot:latest"
SOURCEBOT_REPOS_FILE=""  # Optional: path to repos.txt (one repo per line: org/repo)
SOURCEBOT_DEFAULT_ORG="aws-e"

# --- Ingestion Pipeline -------------------------------------------------------
# Image for the unified ingestion pipeline (ingest-repo.py, ingest-url.py, etc.)
# Build from: modules/agent-context/images/ingestion/Dockerfile
INGESTION_IMAGE="${INGESTION_IMAGE:-python:3.11-slim}"

# CronJob schedule for daily refresh (repos + URLs + infra discovery)
# Default: daily at 6am UTC
INGESTION_REFRESH_SCHEDULE="${INGESTION_REFRESH_SCHEDULE:-0 6 * * *}"
# Set to "false" to skip deploying the refresh CronJob
INGESTION_REFRESH_ENABLED="${INGESTION_REFRESH_ENABLED:-true}"

# Legacy: CodeGraphContext pod removed (Issue #105)
# cgc now runs during ingestion -- no long-running pod needed

# --- OpenViking ---------------------------------------------------------------
OPENVIKING_ROOT_KEY_SECRET_ID="agent-context/openviking-root-key"

# --- Wiki LLM (for incremental updates, lint, and index generation) -----------
# Claude Opus via Bedrock through LiteLLM proxy
WIKI_LLM_MODEL="${WIKI_LLM_MODEL:-bedrock/global.anthropic.claude-opus-4-6-v1}"

# --- DeepWiki -----------------------------------------------------------------
DEEPWIKI_ENABLED="${DEEPWIKI_ENABLED:-true}"
DEEPWIKI_PORT=8001
DEEPWIKI_IMAGE="${DEEPWIKI_IMAGE:-ghcr.io/asyncfuncai/deepwiki-open:latest}"
# Uses the same LiteLLM proxy as OpenViking -- no separate LLM config needed

# --- Runner (for ingestion pipeline RBAC) ------------------------------------
# The ingestion workflow (ingest-content.yml) runs on a GitHub Actions runner
# in a different namespace. These settings control the RBAC binding so the
# runner SA can access secrets, configmaps, deployments, and jobs here.
RUNNER_NAMESPACE="${RUNNER_NAMESPACE:-arc-runners}"
RUNNER_SERVICE_ACCOUNT="${RUNNER_SERVICE_ACCOUNT:-github-runner-sa}"
RUNNER_LABEL="${RUNNER_LABEL:-arc-runner-org}"

# --- GitHub Repo (for setting repo variables via gh CLI) ----------------------
GITHUB_REPO="${GITHUB_REPO:-aws-e/adp}"

# --- GraphRAG (Neptune Serverless + OpenSearch Serverless) --------------------
# Set to "true" to enable GraphRAG entity extraction into Neptune
GRAPHRAG_ENABLED="${GRAPHRAG_ENABLED:-false}"
# Neptune Serverless endpoint (set after Terraform deployment)
NEPTUNE_ENDPOINT="${NEPTUNE_ENDPOINT:-}"
NEPTUNE_PORT="${NEPTUNE_PORT:-8182}"
# OpenSearch Serverless endpoint (set after Terraform deployment)
OPENSEARCH_ENDPOINT="${OPENSEARCH_ENDPOINT:-}"
# Learning artifacts directory (on S3 Files mount)
LEARNING_DIR="${LEARNING_DIR:-/platform-data/learning}"

# --- SQS + DynamoDB (Parallel Ingestion Pipeline) ----------------------------
# SQS queue URL for the parallel ingestion pipeline (set after Terraform deployment)
# When set, refresh-repos.py and ingest-content.yml use the publisher instead of inline processing
SQS_QUEUE_URL="${SQS_QUEUE_URL:-}"
# DynamoDB table for ingestion state tracking (replaces repo-state.json)
DYNAMO_TABLE="${DYNAMO_TABLE:-adp-context-service-state}"

# --- IRSA Role ----------------------------------------------------------------
# Created by modules/agent-context/terraform/modules/iam/
# Populated after terraform apply
IRSA_ROLE_ARN="${IRSA_ROLE_ARN:-}"
