# ============================================================================
# Superplane API Server — Environment Variable Template
# Copy to .env for local development or mount as K8s ConfigMap
# ============================================================================

# Database (Aurora PostgreSQL with IAM auth in production)
#
# Intentionally EMPTY (issue #5683, A04). This field previously shipped a
# connection URI with an inline username and password. This file is a template
# people copy to `.env` and also mount as a ConfigMap, so a credential here
# propagates into both — and a ConfigMap is not a Secret: it is world-readable
# within the namespace and shows up in `kubectl get -o yaml`.
#
# Set this locally in your own uncommitted `.env`. Deployments must NOT set it
# here at all: they inject it from their secret store as a secretKeyRef (see
# deployment.yaml), so the value never enters a file that gets applied.
DATABASE_URL=

# The API refuses to start without a token signing key. There is deliberately no
# value and no default here — supply it from your secret store, never from this
# template. Rotation and cutover: docs/runbooks/superplane-jwt-and-db-credential-rotation.md
JWT_SECRET_KEY=

# Database TLS trust material (issue #5676, A22).
#
# Also intentionally EMPTY, and also NOT settable here for a deployment: like
# DATABASE_URL above, this file is mounted as a ConfigMap, which is readable by
# anything in the namespace. The trusted PEM bundle is injected by reference from
# the `ca-pem` key of the database Secret — see deployment.yaml.
#
# Listed here only so the variable is discoverable. The API, the migration Job and
# the seed Job all REFUSE TO START without it, because without a trusted bundle
# they cannot verify that the endpoint answering on the database's address is
# actually the database. Provision it per environment BEFORE rolling this change:
# docs/runbooks/superplane-database-tls.md
SUPERPLANE_DATABASE_CA=

# AWS
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=605440105851

# Application
APP_NAME=superplane-api
APP_VERSION=0.1.0
DEBUG=false

# CORS (comma-separated origins, or * for development)
CORS_ORIGINS=*
