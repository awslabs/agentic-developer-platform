diff --git a/Tests/test_imagefile.py b/Tests/test_imagefile.py
index 5e7add81c72..2f8750c1d63 100644
--- a/Tests/test_imagefile.py
+++ b/Tests/test_imagefile.py
@@ -440,3 +440,34 @@ def test_encode(self) -> None:
     def test_zero_height(self) -> None:
         with pytest.raises(UnidentifiedImageError):
             Image.open("Tests/images/zero_height.j2k")
+
+    def test_load_prepare(self) -> None:
+        class TestImageFile(ImageFile.ImageFile):
+            def _open(self) -> None:
+                self._mode = "1"
+                self._size = (1, 1)
+                self._frame = 0
+
+            def seek(self, frame: int) -> None:
+                self._mode = "L"
+                self._size = (2, 2)
+                self._frame = frame
+                super().seek(frame)
+
+            def tell(self) -> int:
+                return self._frame
+
+        fp = BytesIO()
+        im = TestImageFile(fp)
+        im.load_prepare()
+        before_seek = im._im
+        assert before_seek is not None
+
+        im.seek(1)
+        after_seek = im._im
+        assert after_seek is None
+
+        im.load_prepare()
+        assert im._im is not None
+        assert im._im.mode == im.mode
+        assert im._im.size == im.size
diff --git a/src/PIL/DcxImagePlugin.py b/src/PIL/DcxImagePlugin.py
index 64762af2622..661b8d6c4ab 100644
--- a/src/PIL/DcxImagePlugin.py
+++ b/src/PIL/DcxImagePlugin.py
@@ -77,6 +77,7 @@ def seek(self, frame: int) -> None:
         self.fp.seek(self._offset[frame])
         PcxImageFile._open(self)
         Image._decompression_bomb_check(self.size)
+        Image.Image.seek(self, frame)
 
     def tell(self) -> int:
         return self.frame
diff --git a/src/PIL/Image.py b/src/PIL/Image.py
index fae0fcffcc9..a62eb198831 100644
--- a/src/PIL/Image.py
+++ b/src/PIL/Image.py
@@ -2746,10 +2746,16 @@ def seek(self, frame: int) -> None:
         """
 
         # overridden by file handlers
-        if frame != 0:
+        if frame != self.tell():
+            # The file handler likely did not override this method
             msg = "no more images in file"
             raise EOFError(msg)
 
+        if self._im is not None and (
+            self.im.size != self.size or self.im.mode != self.mode
+        ):
+            self._im = None
+
     def show(self, title: str | None = None) -> None:
         """
         Displays this image. This method is mainly intended for debugging purposes.
