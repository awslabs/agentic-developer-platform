# Refresh the current qualified release without rebuilding its provider environment.
ARG BASE_IMAGE=879318057152.dkr.ecr.us-east-1.amazonaws.com/adp-superplane-skypilot@sha256:1c759ad92f46a2db57797d111685e06ed66036e76fc0fe4f454da039907cf6a6
ARG MAINTENANCE_IMAGE=879318057152.dkr.ecr.us-east-1.amazonaws.com/adp-superplane-skypilot@sha256:7b3df072a13b928bddbf70d71735fdc8572006442048868914627ebc8e635b68
FROM ${MAINTENANCE_IMAGE} AS maintenance
FROM ${BASE_IMAGE}
USER root
RUN --network=none --mount=type=bind,from=maintenance,source=/,target=/maintenance-input \
    python3 /maintenance-input/maintenance/install.py /maintenance-input
ENV PYTHON_VERSION=3.10.22 PYTHON_SHA256=c61fe9b1a1a7ec2a0b0388e664187c378a5325a89e3606d220abf5bdfccb2543
USER 1000:1000
RUN --network=none python3 /opt/adp-security/high-maintenance/verify_runtime.py
