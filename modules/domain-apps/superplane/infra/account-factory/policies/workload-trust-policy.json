{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::${child_account_id}:oidc-provider/${workspace_oidc_provider}"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "${workspace_oidc_provider}:aud": "sts.amazonaws.com",
          "${workspace_oidc_provider}:sub": "system:serviceaccount:${workspace_namespace}:${workspace_service_account}"
        }
      }
    }
  ]
}
