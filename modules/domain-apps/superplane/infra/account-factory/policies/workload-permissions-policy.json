{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndWriteOnlyThisWorkspacesOwnObjectPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::${workspace_bucket}/${workspace_prefix}/*"
    },
    {
      "Sid": "ListOnlyThisWorkspacesPrefixRatherThanTheWholeBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${workspace_bucket}",
      "Condition": {
        "StringLike": {
          "s3:prefix": "${workspace_prefix}/*"
        }
      }
    },
    {
      "Sid": "DecryptOnlyWithTheKeyThisWorkspacesDataIsEncryptedUnder",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:*:${child_account_id}:key/${workspace_kms_key_id}"
    },
    {
      "Sid": "ConfirmWhichIdentityTenantWorkIsRunningAs",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
