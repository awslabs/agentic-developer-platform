{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTheThreeScopedRolesToDecideWhetherToCreateThem",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": [
        "arn:aws:iam::${child_account_id}:role/AdpAccountBootstrap",
        "arn:aws:iam::${child_account_id}:role/AdpWorkspaceController",
        "arn:aws:iam::${child_account_id}:role/AdpWorkspaceWorkload",
        "arn:aws:iam::${child_account_id}:role/aws-service-role/autoscaling.amazonaws.com/AWSServiceRoleForAutoScaling"
      ]
    },
    {
      "Sid": "CreateOnlyTheControllerAndWorkloadRolesThisPlanNames",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:TagRole"
      ],
      "Resource": [
        "arn:aws:iam::${child_account_id}:role/AdpWorkspaceController",
        "arn:aws:iam::${child_account_id}:role/AdpWorkspaceWorkload"
      ]
    },
    {
      "Sid": "ReadTheReviewedManagedPolicyDocuments",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": [
        "arn:aws:iam::${child_account_id}:policy/AdpAccountBootstrapPermissions",
        "arn:aws:iam::${child_account_id}:policy/AdpWorkspaceControllerPermissions",
        "arn:aws:iam::${child_account_id}:policy/AdpWorkspaceWorkloadPermissions"
      ]
    },
    {
      "Sid": "CreateOrVersionOnlyTheReviewedTierPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion"
      ],
      "Resource": [
        "arn:aws:iam::${child_account_id}:policy/AdpWorkspaceControllerPermissions",
        "arn:aws:iam::${child_account_id}:policy/AdpWorkspaceWorkloadPermissions"
      ]
    },
    {
      "Sid": "AttachOnlyTheReviewedControllerPermissionPolicy",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::${child_account_id}:role/AdpWorkspaceController",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::${child_account_id}:policy/AdpWorkspaceControllerPermissions"
        }
      }
    },
    {
      "Sid": "AttachOnlyTheReviewedWorkloadPermissionPolicy",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::${child_account_id}:role/AdpWorkspaceWorkload",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::${child_account_id}:policy/AdpWorkspaceWorkloadPermissions"
        }
      }
    },
    {
      "Sid": "CreateTheAutoScalingServiceLinkedRoleAndNoOtherServices",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::${child_account_id}:role/aws-service-role/autoscaling.amazonaws.com/AWSServiceRoleForAutoScaling",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "autoscaling.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadAndSetTheAccountLevelS3PublicAccessBlock",
      "Effect": "Allow",
      "Action": [
        "s3:GetAccountPublicAccessBlock",
        "s3:PutAccountPublicAccessBlock"
      ],
      "Resource": "*"
    },
    {
      "Sid": "VerifyAnAuditTrailCoversThisAccountWithoutBeingAbleToChangeOne",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:DescribeTrails",
        "cloudtrail:GetTrailStatus"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConfirmWhichIdentityBootstrapIsActuallyRunningAs",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
