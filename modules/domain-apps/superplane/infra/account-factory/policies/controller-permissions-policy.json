{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReconcileTheWorkspaceClustersThisTagMarksAsAdpManaged",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster",
        "eks:DescribeNodegroup",
        "eks:CreateCluster",
        "eks:CreateNodegroup",
        "eks:TagResource",
        "eks:UpdateClusterConfig",
        "eks:UpdateNodegroupConfig"
      ],
      "Resource": [
        "arn:aws:eks:*:${child_account_id}:cluster/adp-*",
        "arn:aws:eks:*:${child_account_id}:nodegroup/adp-*/*/*"
      ]
    },
    {
      "Sid": "BuildTheWorkspaceNetworkItsClustersLaunchInto",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateSecurityGroup",
        "ec2:CreateTags",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress"
      ],
      "Resource": "arn:aws:ec2:*:${child_account_id}:*/*"
    },
    {
      "Sid": "ReadTheNetworkAndClusterStateItReconcilesAgainst",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeRouteTables"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UseButNeverAdministerTheWorkspaceKmsKey",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:CreateGrant"
      ],
      "Resource": "arn:aws:kms:*:${child_account_id}:key/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/adp.aws.dev/managed-by": "adp-superplane-account-factory"
        }
      }
    },
    {
      "Sid": "PassOnlyTheWorkspaceRolesAndOnlyToTheServicesThatRunThem",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::${child_account_id}:role/adp-workspace-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "eks.amazonaws.com",
            "ec2.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ConfirmWhichIdentityTheControllerIsActuallyRunningAs",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
