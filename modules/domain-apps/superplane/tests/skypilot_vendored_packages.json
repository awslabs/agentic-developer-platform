  "findings": [
    {
      "advisory": "GHSA-58pv-8j8x-9vj2",
      "package": "jaraco-context",
      "version": "5.3.0",
      "reported_fix": "6.1.0",
      "result_index": 440,
      "location": "/usr/local/lib/python3.10/site-packages/setuptools/_vendor/jaraco.context-5.3.0.dist-info/METADATA",
      "bundled": true,
      "bundled_in": {
        "name": "setuptools",
        "version": "78.1.1"
      },
      "fixed_by_containing_version": "81.0.0",
      "status": "open",
      "reason": "Zip-slip in jaraco.context.tarball()'s strip_first_component filter. Present and executable in the vendored copy \u2014 the reproduction in S03-jaraco-context-traversal-check.py writes a file outside the extraction destination using this exact copy, and the setuptools >= 81 copy refuses it with OutsideDestinationError. Not reachable through SkyPilot in this deployment: setuptools imports only ExceptionTrap from its vendored jaraco.context, never tarball, and the skypilot 0.12.x wheel contains no reference to jaraco at all. Reaching it needs a caller that invokes tarball() on an attacker-chosen URL; no such caller is in the image's Python path for the API server. Survives every 0.12.x image because all of them ship setuptools 78.1.1."
    },
    {
      "advisory": "GHSA-8rrh-rw8j-w5fx",
      "package": "wheel",
      "version": "0.45.1",
      "reported_fix": "0.46.2",
      "result_index": 444,
      "location": "/usr/local/lib/python3.10/site-packages/setuptools/_vendor/wheel-0.45.1.dist-info/METADATA",
      "bundled": true,
      "bundled_in": {
        "name": "setuptools",
        "version": "78.1.1"
      },
      "fixed_by_containing_version": "81.0.0",
      "status": "open",
      "reason": "Path traversal in wheel.cli.unpack applying an archive member's permission bits to an unsanitized joined path, so a crafted wheel can chmod files outside the destination. The vulnerable unpack module is present in setuptools 78.1.1's vendored copy; setuptools >= 81 vendors wheel 0.46.3, which chmods the sanitized path returned by extract() instead. Reaching it requires running the wheel unpack CLI on an untrusted wheel, which the SkyPilot API server does not do \u2014 it is build-time tooling, and this copy is setuptools-private. Note the top-level wheel in this image is already 0.46.3 (patched): this finding is exclusively the vendored duplicate, which is why a pip upgrade does not clear it."
    },
    {
      "advisory": "GHSA-72hv-8253-57qq",
      "package": "jackson-core",
      "version": "2.16.1",
      "reported_fix": "2.18.6",
      "result_index": 442,
      "location": "/usr/local/lib/python3.10/site-packages/ray/jars/ray_dist.jar",
      "bundled": true,
      "bundled_in": {
        "name": "ray",
        "version": "2.54.0"
      },
      "fixed_by_containing_version": "2.55.1",
      "status": "fixed_in_candidate",
      "reason": "Number-length constraint bypass in jackson-core's async JSON parser, a denial-of-service condition, inside Ray's shaded JAR. Cleared by moving to SkyPilot 0.12.3, which ships ray 2.55.1 with jackson-core 2.18.6 in the same JAR path \u2014 confirmed by both syft inventory and a grype rescan of the candidate digest."
    },
    {
      "advisory": "GHSA-r6ph-v2qm-q3c2",
      "package": "cryptography",
      "version": "43.0.3",
      "reported_fix": "46.0.5",
      "result_index": 448,
      "location": "/usr/local/lib/python3.10/site-packages/cryptography-43.0.3.dist-info/METADATA",
      "bundled": false,
      "bundled_in": null,
      "fixed_by_containing_version": null,
      "status": "fixed_in_candidate",
      "reason": "Missing subgroup validation for SECT (binary-field) elliptic curves. The only top-level package among the five. Cleared by moving to SkyPilot 0.12.3, which installs cryptography 46.0.5 \u2014 the advisory's own fix version \u2014 confirmed by syft inventory and grype rescan of the candidate digest."
    },
    {
      "advisory": "CVE-2023-36632",
      "package": "python",
      "version": "3.10.19",
      "reported_fix": "",
      "result_index": 104,
      "location": "/usr/local/bin/python3.10",
      "bundled": false,
      "bundled_in": null,
      "fixed_by_containing_version": null,
      "status": "disputed_not_applicable",
      "reason": "An NVD CPE match against the interpreter binary, not a package advisory. CPython's maintainers state this is neither a vulnerability nor a bug: email.utils.parseaddr is a documented Legacy API and the RecursionError is the email package's intended size-limit behaviour. It also carries no fix version, so no image upgrade can clear it \u2014 the interpreter is still 3.10.19 in every 0.12.x candidate. Independently not applicable here: parseaddr appears nowhere in the skypilot 0.12.x wheel, so the cited API is not called by the code this deployment runs."
    }
  ],
