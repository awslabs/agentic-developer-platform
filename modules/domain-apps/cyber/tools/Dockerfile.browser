FROM python:3.13-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b
RUN groupadd -g 1001 agent && useradd -u 1001 -g agent -m agent
WORKDIR /app
COPY modules/domain-apps/cyber/browser/requirements.txt /tmp/browser-requirements.txt
RUN pip install --no-cache-dir -r /tmp/browser-requirements.txt rfc8785==0.1.4 fastapi==0.136.3
COPY modules/tools/adp_tools/ /app/adp_tools/
COPY modules/domain-apps/cyber/tools/cyber_tools/ /app/cyber_tools/
COPY modules/domain-apps/cyber/agent/skills/url-analysis/ /app/skills/url-analysis/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/skills/url-analysis
USER 1001:1001
CMD ["python3", "-m", "cyber_tools.browser_http"]
