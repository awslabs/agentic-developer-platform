# Replace identifiers with confirmed resources. Leave both gates off for review.
enabled            = false
capability_enabled = false
aws_account_id     = "123456789012"
aws_region         = "us-east-1"
name               = "adp-dev-cyber-tools"
# Set to the published repository@sha256 digest before enabling infrastructure.
image_uri                = ""
rest_api_id              = "REPLACE"
tools_parent_resource_id = "REPLACE"
api_execution_arn        = "arn:aws:execute-api:us-east-1:123456789012:replace"
stage_name               = "dev"
worker_role_arns         = ["arn:aws:iam::123456789012:role/REPLACE-task-worker"]
authority_endpoint       = "https://REPLACE.example/internal/v1/agent/task"
authority_invoke_arns    = [] # Exactly the stage-qualified tool-authorize and artifact POST ARNs.
sample_bucket_arn        = "arn:aws:s3:::replace-sample-bucket"
queue_arns               = []
results_table_arn        = ""
secret_arns              = []
kms_key_arns             = []
backend_environment      = {}
subnet_ids               = []
security_group_ids       = []
