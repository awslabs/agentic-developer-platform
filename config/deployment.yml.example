# ADP deployment configuration
# ============================
#
# Single source of truth for an ADP deployment's target. Read by the deploy
# scripts (platform/scripts/*.sh) and the GitHub Actions workflows
# (.github/workflows/*.yml) via platform/scripts/load-deploy-config.sh.
#
# Setup
# -----
# Copy this file to `config/deployment.yml` (gitignored) and fill in your
# values. `setup-org.sh` will create it for you from a fresh clone.
#
# Backwards compatibility
# -----------------------
# All fields are optional. When `config/deployment.yml` is missing or a
# field is empty, the helper script falls back to runtime-derived defaults
# (e.g. `account_id` becomes `aws sts get-caller-identity` Account). This
# means existing deploys keep working without any config file present.

# AWS account that owns the ADP platform (the runner / EKS / ECR live here).
# Leave empty to derive from `aws sts get-caller-identity` at runtime.
account_id: ""

# AWS region. Leave empty to use $AWS_REGION env or aws configure default.
region: us-east-1

# Deployment environment. Used in resource names like `adp-${environment}-eks-cluster`.
environment: dev

# GitHub org that owns the repo. Used by setup-org.sh and register-github-app.sh.
# Leave empty to derive from the git remote URL at runtime.
github_org: ""

# =============================================================================
# Optional: customer_account — gateway-mediated cross-account assume
# =============================================================================
# When to use:
#
#   ✅ ADP-managed track ONLY: scripts / workflows run inside ADP's platform
#      pods (in-cluster), the operator is a vaulted ADP user, and the
#      deploy target is the user's linked AWS account. The pod has no direct
#      creds for the customer account, so the helper calls the gateway's
#      /internal/v1/credential-assume-role endpoint to get them.
#
#   ❌ DO NOT use for self-managed / self-hosted deploys. If you're running
#      from your laptop, your own CI runner, or anywhere with direct AWS
#      creds for the target account, just set `account_id` (top-level) to
#      that account. No gateway hop needed; your existing creds work.
#
# Decision matrix:
#
#   I'm running from...           | What to set
#   ──────────────────────────────┼─────────────────────────────────────
#   My laptop (`aws configure`)   | account_id (top level) only
#   My company's GitHub Actions   | account_id (top level) only
#   ADP's platform pod (orchestr.)| customer_account block (this section)
#
# Prerequisites for the ADP-managed track (one-time, manual today):
#   1. Customer links an AWS account in the ADP dashboard ("Connect AWS
#      account" flow). Creates `ADP-Agent-<label>` role in their account
#      with ReadOnlyAccess + a trust policy on the gateway IRSA principal.
#   2. Customer manually attaches `AdministratorAccess` (or equivalent) to
#      that role in IAM console — needed for terraform deploy steps.
#      Scoping the permissions tighter is a future hardening step.
#
# Failure mode if mis-set: if you set this block from outside the ADP
# cluster, the helper logs `::error:: gateway unreachable` (DNS won't
# resolve in-cluster service from outside) and continues with your existing
# AWS creds. Non-fatal but noisy — fix by removing this block and using
# top-level account_id instead.
#
# customer_account:
#   account_id: "403685770643"      # the linked customer account to deploy ADP into
#   aws_label: Dep-testing          # which vaulted credential label the gateway resolves
#   user_id: "650f093f-ecd9-4ce1-a5a9-368e02c449cf"  # your Postgres users.id from the ADP dashboard
#   gateway_url: "http://bedrockgateway.adp-gateway"  # in-cluster default; override only for non-EKS runners
