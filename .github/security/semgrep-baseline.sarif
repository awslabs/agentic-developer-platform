                    "text": "        run: |\n          BUILD_DATE=$(date -u +%Y-%m-%d)\n          TARGET=\"s3://${{ env.ASSETS_BUCKET }}/win11-cape-${BUILD_DATE}.qcow2\"\n          echo \"Waiting for: $TARGET\"\n          echo \"Expected build time: 60-90 minutes\"\n\n          # Also check for a failure marker\n          FAIL_MARKER=\"s3://${{ env.ASSETS_BUCKET }}/windows-build-inputs/BUILD_FAILED_${BUILD_DATE}\"\n\n          # Wait up to 96 minutes (384 iterations * 15s)\n          for i in $(seq 1 384); do\n            # Check for success (qcow2 exists)\n            if aws s3 ls \"$TARGET\" --region \"${AWS_REGION}\" 2>/dev/null | grep -q \"qcow2\"; then\n              SIZE=$(aws s3api head-object --bucket \"${{ env.ASSETS_BUCKET }}\" \\\n                --key \"win11-cape-${BUILD_DATE}.qcow2\" --region \"${AWS_REGION}\" \\\n                --query 'ContentLength' --output text 2>/dev/null || echo \"0\")\n              echo \"Build complete! qcow2 size: $SIZE bytes\"\n              if (( SIZE > 1000000000 )); then\n                echo \"Size looks valid (> 1GB). Build succeeded.\"\n                break\n              fi\n              echo \"Size too small, build may still be uploading...\"\n            fi\n\n            # Check for failure marker\n            if aws s3 ls \"$FAIL_MARKER\" --region \"${AWS_REGION}\" 2>/dev/null | grep -q \"BUILD_FAILED\"; then\n              echo \"ERROR: Build failed on the build host.\"\n              aws s3 cp \"$FAIL_MARKER\" - --region \"${AWS_REGION}\" 2>/dev/null || true\n              exit 1\n            fi\n\n            if (( i % 12 == 0 )); then\n              echo \"  Still building... ($((i * 15 / 60)) min elapsed)\"\n            fi\n            sleep 15\n          done\n\n          # Final check\n          if ! aws s3 ls \"$TARGET\" --region \"${AWS_REGION}\" 2>/dev/null | grep -q \"qcow2\"; then\n            echo \"ERROR: Build timed out after 96 minutes. No qcow2 in S3.\"\n            exit 1\n          fi"
