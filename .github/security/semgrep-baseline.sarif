                    "text": "        run: |\n          if [ \"${{ github.event_name }}\" = \"workflow_dispatch\" ]; then\n            INPUT=\"${{ inputs.image }}\"\n            if [ \"$INPUT\" = \"all\" ]; then\n              echo 'matrix={\"image\":[\"ingestion\",\"codegraph-context\",\"litellm-proxy\",\"deepwiki\",\"context-mcp\"]}' >> \"$GITHUB_OUTPUT\"\n            else\n              echo \"matrix={\\\"image\\\":[\\\"$INPUT\\\"]}\" >> \"$GITHUB_OUTPUT\"\n            fi\n          else\n            # Detect which image directories changed\n            CHANGED=$(git diff --name-only HEAD^ HEAD \\\n              | grep '^modules/agent-context/images/' \\\n              | awk -F/ '{print $4}' \\\n              | sort -u \\\n              | jq -R . \\\n              | jq -sc .)\n            # If buildspec or workflow changed, rebuild all\n            if git diff --name-only HEAD^ HEAD | grep -qE '(codebuild/bs-agent-context-image\\.yml|\\.github/workflows/agent-context-images-build\\.yml)'; then\n              echo 'matrix={\"image\":[\"ingestion\",\"codegraph-context\",\"litellm-proxy\",\"deepwiki\",\"context-mcp\"]}' >> \"$GITHUB_OUTPUT\"\n            else\n              # If door/ or personal_context/ changed, include context-mcp (its source deps)\n              if git diff --name-only HEAD^ HEAD | grep -qE '^modules/agent-context/(door|personal_context)/'; then\n                CHANGED=$(echo \"$CHANGED\" | jq -c '. + [\"context-mcp\"] | unique')\n              fi\n              if [ \"$CHANGED\" = \"[]\" ] || [ -z \"$CHANGED\" ]; then\n                echo 'matrix={\"image\":[]}' >> \"$GITHUB_OUTPUT\"\n              else\n                echo \"matrix={\\\"image\\\":$CHANGED}\" >> \"$GITHUB_OUTPUT\"\n              fi\n            fi\n          fi"
