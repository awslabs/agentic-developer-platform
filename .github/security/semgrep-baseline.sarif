                    "text": "        run: |\n          set -e\n          TARGET=\"${{ inputs.terraform_target }}\"\n          # Skip cost guard when targeting a non-GraphRAG module\n          if [ -n \"$TARGET\" ]; then\n            if echo \"$TARGET\" | grep -qvE '(neptune|opensearch)'; then\n              echo \"Targeted apply ($TARGET) \u2014 does not include GraphRAG resources. Skipping cost guard.\"\n              exit 0\n            fi\n          fi\n          # Check effective graphrag_enabled value (TF_VAR overrides tfvars)\n          GRAPHRAG_ENABLED=\"${TF_VAR_graphrag_enabled:-}\"\n          if [ -z \"$GRAPHRAG_ENABLED\" ]; then\n            GRAPHRAG_ENABLED=$(grep 'graphrag_enabled' \"${{ env.VAR_FILE }}\" | sed 's/.*=\\s*//' | tr -d ' \"' || echo \"false\")\n          fi\n          # Check effective neptune_enabled value (TF_VAR overrides tfvars).\n          # Neptune is gated separately from OpenSearch/GraphRAG but still costs money,\n          # so it shares the same CONFIRM_GRAPHRAG_COST guard.\n          NEPTUNE_ENABLED=\"${TF_VAR_neptune_enabled:-}\"\n          if [ -z \"$NEPTUNE_ENABLED\" ]; then\n            NEPTUNE_ENABLED=$(grep 'neptune_enabled' \"${{ env.VAR_FILE }}\" | sed 's/.*=\\s*//' | tr -d ' \"' || echo \"false\")\n          fi\n          echo \"graphrag_enabled=$GRAPHRAG_ENABLED neptune_enabled=$NEPTUNE_ENABLED\"\n          if [ \"$GRAPHRAG_ENABLED\" = \"true\" ] || [ \"$NEPTUNE_ENABLED\" = \"true\" ]; then\n            echo \"## :warning: Graph Infrastructure Cost Warning\" >> \"$GITHUB_STEP_SUMMARY\"\n            echo \"\" >> \"$GITHUB_STEP_SUMMARY\"\n            [ \"$NEPTUNE_ENABLED\" = \"true\" ] && echo \"- **neptune_enabled=true** \u2014 Neptune Serverless: ~\\$105/month idle\" >> \"$GITHUB_STEP_SUMMARY\"\n            [ \"$GRAPHRAG_ENABLED\" = \"true\" ] && echo \"- **graphrag_enabled=true** \u2014 OpenSearch Serverless: ~\\$700/month idle\" >> \"$GITHUB_STEP_SUMMARY\"\n            echo \"\" >> \"$GITHUB_STEP_SUMMARY\"\n            # Check for CONFIRM_GRAPHRAG_COST repo variable (covers both Neptune and OpenSearch)\n            CONFIRM=\"${{ vars.CONFIRM_GRAPHRAG_COST }}\"\n            if [ \"$CONFIRM\" != \"yes\" ]; then\n              echo \"::error::neptune_enabled and/or graphrag_enabled is true but repo variable CONFIRM_GRAPHRAG_COST is not 'yes'.\"\n              echo \"Set the repo variable (Settings -> Secrets and variables -> Actions -> Variables -> CONFIRM_GRAPHRAG_COST=yes), OR set the flags false in ${{ env.VAR_FILE }}.\"\n              exit 1\n            fi\n            echo \"CONFIRM_GRAPHRAG_COST=yes confirmed. Proceeding with graph infrastructure.\" >> \"$GITHUB_STEP_SUMMARY\"\n          fi"
