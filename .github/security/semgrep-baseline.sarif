                    "text": "        run: |\n          set -euo pipefail\n          TENANT_ID='${{ inputs.tenant_id }}'\n          ORG_NAME='${{ inputs.org_name }}'\n          INSTALLATION_ID='${{ inputs.installation_id }}'\n          DEPT_ID=\"${TENANT_ID}-dept-default\"\n          TEAM_ID=\"${TENANT_ID}-team-default\"\n\n          cat > /tmp/seed.sql <<SQL\n          INSERT INTO organizations (id, name, aws_accounts, role_mappings, settings, created_at)\n          VALUES ('$TENANT_ID', '$ORG_NAME', '[]'::jsonb, '{}'::jsonb, '{}'::jsonb, now())\n          ON CONFLICT (id) DO UPDATE SET name = EXCLUDED.name;\n\n          INSERT INTO departments (id, name, org_id)\n          VALUES ('$DEPT_ID', 'Default', '$TENANT_ID')\n          ON CONFLICT (id) DO NOTHING;\n\n          INSERT INTO teams (id, name, department_id, org_id)\n          VALUES ('$TEAM_ID', 'Default', '$DEPT_ID', '$TENANT_ID')\n          ON CONFLICT (id) DO NOTHING;\n\n          INSERT INTO channel_tenant_map (id, provider, provider_scope_id, org_id, created_at)\n          VALUES (gen_random_uuid()::text, 'github', '$INSTALLATION_ID', '$TENANT_ID', now())\n          ON CONFLICT (provider, provider_scope_id) DO NOTHING;\n\n          \\echo '--- Verify ---'\n          SELECT 'organizations' AS \"table\", COUNT(*) AS rows FROM organizations WHERE id = '$TENANT_ID'\n          UNION ALL\n          SELECT 'departments',   COUNT(*) FROM departments   WHERE org_id = '$TENANT_ID'\n          UNION ALL\n          SELECT 'teams',         COUNT(*) FROM teams         WHERE org_id = '$TENANT_ID'\n          UNION ALL\n          SELECT 'channel_tenant_map', COUNT(*) FROM channel_tenant_map\n                WHERE provider = 'github' AND provider_scope_id = '$INSTALLATION_ID';\n          SQL\n\n          echo \"=== Planned SQL ===\"\n          cat /tmp/seed.sql"
                  },
                  "startColumn": 9,
                  "startLine": 81
                }
