                    "text": "        run: |\n          cd modules/agent-context\n          source scripts/_common.sh\n          load_config \"$(pwd)\"\n\n          # Issue #2213: Read SQS queue URL from SSM (same source as ConfigMap step)\n          SQS_QUEUE_URL=$(aws ssm get-parameter \\\n            --name \"/adp/${ENVIRONMENT}/agent-context/ingestion-queue-url\" \\\n            --query \"Parameter.Value\" --output text 2>/dev/null || echo \"\")\n          echo \"SQS_QUEUE_URL=${SQS_QUEUE_URL:-(not set \u2014 ScaledJob will be skipped)}\"\n\n          # Determine ingestion image\n          INGESTION_REPO=\"adp-${ENVIRONMENT}-agent-context-ingestion\"\n          INPUT_TAG=\"${{ inputs.ingestion_image_tag }}\"\n          if [ -n \"$INPUT_TAG\" ]; then\n            INGESTION_IMAGE=\"${ECR_REGISTRY}/${INGESTION_REPO}:${INPUT_TAG}\"\n          else\n            # Get latest built tag\n            LATEST_TAG=$(aws ecr describe-images --repository-name \"${INGESTION_REPO}\" \\\n              --region ${{ env.AWS_REGION }} --query 'sort_by(imageDetails,&imagePushedAt)[-1].imageTags[0]' \\\n              --output text 2>/dev/null || echo \"\")\n            if [ -n \"$LATEST_TAG\" ] && [ \"$LATEST_TAG\" != \"None\" ]; then\n              INGESTION_IMAGE=\"${ECR_REGISTRY}/${INGESTION_REPO}:${LATEST_TAG}\"\n            fi\n          fi\n          export INGESTION_IMAGE\n          echo \"Ingestion image: ${INGESTION_IMAGE}\"\n\n          # Create content ConfigMap\n          kubectl create configmap ingestion-content-config \\\n            --from-file=repos.txt=index_content/repos.txt \\\n            --from-file=urls.txt=index_content/urls.txt \\\n            --from-file=docs.txt=index_content/docs.txt \\\n            --from-file=accounts.txt=index_content/accounts.txt \\\n            -n ${{ env.NAMESPACE }} --dry-run=client -o yaml | kubectl apply -f -\n\n          # Deploy CronJob\n          export NAMESPACE SERVICE_ACCOUNT INGESTION_REFRESH_SCHEDULE SQS_QUEUE_URL DYNAMO_TABLE\n          template_file manifests/repo-refresh-cronjob.yaml | kubectl apply -f -\n          echo \"Ingestion CronJob deployed\"\n\n          # Deploy KEDA ScaledJob (if SQS configured)\n          if [ -n \"${SQS_QUEUE_URL:-}\" ] && [ -f manifests/ingestion-scaledjob.yaml ]; then\n            export DEEPWIKI_URL=\"http://deepwiki.${NAMESPACE}.svc.cluster.local:8001\"\n            export LLM_BASE_URL=\"http://litellm-proxy.${NAMESPACE}.svc.cluster.local:4000/v1\"\n            export DEEPWIKI_ENABLED GRAPHRAG_ENABLED NEPTUNE_ENDPOINT NEPTUNE_PORT OPENSEARCH_ENDPOINT\n            export WIKI_LLM_MODEL ECR_REGISTRY\n            template_file manifests/ingestion-scaledjob.yaml | kubectl apply -f -\n            echo \"KEDA ScaledJob deployed\"\n          fi"
                  },
                  "startColumn": 9,
                  "startLine": 388
                }
              }
            }
          ],
          "message": {
            "text": "Using variable interpolation `${{...}}` with `github` context data in a `run:` step could allow an attacker to inject their own code into the runner. This would allow them to steal secrets and code. `github` context data can have arbitrary user input and should be treated as untrusted. Instead, use an intermediate environment variable with `env:` to store the data and use the environment variable in the `run:` script. Be sure to use double-quotes the environment variable, like this: \"$ENVVAR\"."
