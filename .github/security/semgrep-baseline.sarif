                    "text": "        run: |\n          set -e\n          # Count destroys without exiting non-zero on no-match (grep -c returns 1 when no match).\n          DESTROYS=$(grep -c 'will be destroyed' /tmp/plan-output.txt 2>/dev/null) || DESTROYS=0\n          if [ \"$DESTROYS\" -le 0 ]; then\n            echo \"No destroys in plan. Proceeding.\"\n            exit 0\n          fi\n\n          echo \"Plan includes $DESTROYS resource(s) to destroy.\"\n          echo \"\"\n          echo \"Resources to be destroyed:\"\n          grep 'will be destroyed' /tmp/plan-output.txt || true\n          echo \"\"\n\n          # workflow_dispatch: require explicit operator confirmation.\n          if [ \"${{ github.event_name }}\" = \"workflow_dispatch\" ]; then\n            if [ \"${{ inputs.confirm_destructive_apply }}\" = \"yes\" ]; then\n              echo \"Operator-confirmed destructive apply (confirm_destructive_apply=yes). Proceeding.\"\n              exit 0\n            fi\n            echo \"::error::This workflow_dispatch run schedules $DESTROYS destroy(s).\"\n            echo \"::error::Re-run with confirm_destructive_apply=yes to authorize. Or fix the underlying drift first.\"\n            exit 1\n          fi\n\n          # push / other events: require destructive-apply-approved label on the merged PR.\n          COMMIT_SHA=\"${{ github.sha }}\"\n          PR_NUMBER=$(gh pr list --state merged --search \"$COMMIT_SHA\" --json number --jq '.[0].number // empty' 2>/dev/null || echo \"\")\n          if [ -z \"$PR_NUMBER\" ]; then\n            echo \"::error::This apply would destroy $DESTROYS resource(s) but no associated merged PR was found for SHA $COMMIT_SHA. Cannot verify destructive-apply-approved label.\"\n            exit 1\n          fi\n          echo \"Associated PR: #$PR_NUMBER\"\n\n          # Use grep -qx (exact, quiet) instead of grep -c piped through arithmetic.\n          # Empty stdin to grep returns exit 1, which is what we want for \"no match\".\n          LABELS=$(gh pr view \"$PR_NUMBER\" --json labels --jq '.labels[].name' 2>/dev/null || echo \"\")\n          if echo \"$LABELS\" | grep -qx 'destructive-apply-approved'; then\n            echo \"PR #$PR_NUMBER has 'destructive-apply-approved' label. Proceeding.\"\n          else\n            echo \"::error::This apply would destroy $DESTROYS resource(s). PR #$PR_NUMBER does NOT have the 'destructive-apply-approved' label.\"\n            echo \"::error::Add the label to PR #$PR_NUMBER and re-run, or trigger manually with confirm_destructive_apply=yes.\"\n            exit 1\n          fi"
