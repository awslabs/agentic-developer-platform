                  "snippet": {
                    "text": "        run: |\n          set -e\n          cd modules/agent-context\n          source scripts/_common.sh\n          load_config \"$(pwd)\"\n\n          # Resolve RDS host from SSM (published by infra-apply)\n          RDS_HOST=$(aws ssm get-parameter \\\n            --name \"/adp/${{ env.ENVIRONMENT }}/rds/endpoint\" \\\n            --region \"${{ env.AWS_REGION }}\" \\\n            --query 'Parameter.Value' --output text 2>/dev/null || echo \"\")\n          if [ -z \"$RDS_HOST\" ]; then\n            echo \"::error::RDS host not found in SSM (/adp/${{ env.ENVIRONMENT }}/rds/endpoint). Run infra-apply first.\"\n            exit 1\n          fi\n\n          # Determine ingestion image (same logic as CronJob step)\n          INGESTION_REPO=\"adp-${{ env.ENVIRONMENT }}-agent-context-ingestion\"\n          INPUT_TAG=\"${{ inputs.ingestion_image_tag }}\"\n          if [ -n \"$INPUT_TAG\" ]; then\n            MIGRATION_IMAGE=\"${{ env.ECR_REGISTRY }}/${INGESTION_REPO}:${INPUT_TAG}\"\n          else\n            LATEST_TAG=$(aws ecr describe-images --repository-name \"${INGESTION_REPO}\" \\\n              --region ${{ env.AWS_REGION }} --query 'sort_by(imageDetails,&imagePushedAt)[-1].imageTags[0]' \\\n              --output text 2>/dev/null || echo \"\")\n            if [ -n \"$LATEST_TAG\" ] && [ \"$LATEST_TAG\" != \"None\" ]; then\n              MIGRATION_IMAGE=\"${{ env.ECR_REGISTRY }}/${INGESTION_REPO}:${LATEST_TAG}\"\n            else\n              echo \"::error::No ingestion image found in ECR. Run images-build first.\"\n              exit 1\n            fi\n          fi\n\n          # Generate unique Job ID (short git SHA + timestamp)\n          MIGRATION_JOB_ID=\"$(date +%s)-$(echo $GITHUB_SHA | head -c 7)\"\n\n          # Template and apply migration Job\n          export NAMESPACE=\"${{ env.NAMESPACE }}\"\n          export SERVICE_ACCOUNT=\"${SERVICE_ACCOUNT:-agent-context-sa}\"\n          export INGESTION_IMAGE=\"$MIGRATION_IMAGE\"\n          export AC_RDS_HOST=\"$RDS_HOST\"\n          export AC_RDS_PORT=\"5432\"\n          export AC_RDS_USERNAME=\"agent_context_svc\"\n          export AC_RDS_DBNAME=\"agent_context\"\n          export AC_AWS_REGION=\"${{ env.AWS_REGION }}\"\n          export MIGRATION_JOB_ID\n\n          echo \"Launching migration Job (image: ${MIGRATION_IMAGE})...\"\n          echo \"  RDS host: ${RDS_HOST}\"\n          template_file manifests/migration-job.yaml | kubectl apply -f -\n\n          # Wait for Job completion (blocking \u2014 deploy fails if migration fails)\n          JOB_NAME=\"agent-context-migration-${MIGRATION_JOB_ID}\"\n          echo \"Waiting for Job ${JOB_NAME} to complete...\"\n          if ! kubectl wait --for=condition=complete \"job/${JOB_NAME}\" \\\n            -n ${{ env.NAMESPACE }} --timeout=240s 2>/dev/null; then\n            # Check if it failed (not just timed out)\n            JOB_STATUS=$(kubectl get job \"${JOB_NAME}\" -n ${{ env.NAMESPACE }} \\\n              -o jsonpath='{.status.conditions[?(@.type==\"Failed\")].status}' 2>/dev/null || echo \"\")\n            if [ \"$JOB_STATUS\" = \"True\" ]; then\n              echo \"::error::Migration Job FAILED. Logs:\"\n              kubectl logs \"job/${JOB_NAME}\" -n ${{ env.NAMESPACE }} --tail=50 || true\n              exit 1\n            fi\n            # Timed out \u2014 check once more\n            COMPLETE=$(kubectl get job \"${JOB_NAME}\" -n ${{ env.NAMESPACE }} \\\n              -o jsonpath='{.status.conditions[?(@.type==\"Complete\")].status}' 2>/dev/null || echo \"\")\n            if [ \"$COMPLETE\" != \"True\" ]; then\n              echo \"::error::Migration Job timed out (240s). Logs:\"\n              kubectl logs \"job/${JOB_NAME}\" -n ${{ env.NAMESPACE }} --tail=50 || true\n              exit 1\n            fi\n          fi\n\n          echo \"\u2705 Migration Job completed successfully\"\n          kubectl logs \"job/${JOB_NAME}\" -n ${{ env.NAMESPACE }} --tail=20 || true"
