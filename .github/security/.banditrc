# Bandit configuration for ADP security scanning
# Docs: https://bandit.readthedocs.io/en/latest/config.html
# Format: YAML (bandit >=1.6)

# Skip low-confidence findings to reduce noise
skips:
  - B101  # assert used — acceptable in tests and type narrowing
  - B311  # random — non-security random usage is common in non-crypto code

# Exclude test files and generated code
exclude_dirs:
  - tests
  - node_modules
  - .git
  - venv
  - .venv
  - __pycache__

assert_used:
  skips:
    - "*/tests/*"
